includes:
    - ./vendor/larastan/larastan/extension.neon

parameters:
    level: 1

    # Laravel specific configurations
    noModelMake: true
    noUnnecessaryCollectionCall: true
    noUnnecessaryEnumerableToArrayCalls: true
    checkModelProperties: true
    checkOctaneCompatibility: true
    noEnvCallsOutsideOfConfig: true
    checkModelAppends: true
    checkModelMethodVisibility: true
    checkAuthCallsWhenInRequestScope: true
    checkConfigTypes: true

    checkMissingTranslations: false
    translationDirectories:
        - resources/lang

    paths:
        - app/
        - config/
        - database/
        - resources/
        - routes/
        - tests/

    excludePaths:
        - bootstrap/cache/*
        - storage/
        - vendor/
        - app/Http/Controllers/Groups/GroupsPostController.php
        - app/Jobs/GroupPipeline/NewStatusPipeline.php

    ignoreErrors:
        - '#PHPDoc tag @var#'
