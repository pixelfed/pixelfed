includes:
    - ./vendor/larastan/larastan/extension.neon

parameters:
    paths:
        - app/
        - config/
        - database/
        - resources/
        - routes/
        - tests/

    level: 1

    ignoreErrors:
        - '#PHPDoc tag @var#'
        - '#Class App\\Http\\Controllers\\Groups\\VideoThumbnail was not found#'
        - '#Class App\\Http\\Controllers\\Groups\\StatusDelete was not found#'
        - '#Class App\\Jobs\\GroupPipeline\\MentionPipeline was not found#'

    excludePaths:
        - app/Http/Controllers/Groups/GroupsPostController.php
        - app/Jobs/GroupPipeline/NewStatusPipeline.php
