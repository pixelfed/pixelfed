##############################################################################
# Pixelfed — Full Environment Variable Reference (.env.example.full)
#
# This file documents EVERY environment variable read by Pixelfed's config/
# files, including third-party packages (Horizon, Telescope, Pulse, LDAP,
# etc). It is a REFERENCE, not a starter file — do not copy this wholesale
# into production. Start from `.env.example` and only override what you need;
# every variable below is commented out with its default value shown, so
# copying a whole section as-is is a safe no-op until you uncomment lines.
#
# Format: each variable is preceded by a short description, the config/
# file(s) + key path(s) that read it ("Key:" for a single file, "Used by
# N config files:" with one bullet per file when several files share the
# same variable), an "Origin:" line saying whether that config file ships
# with stock Laravel, is Pixelfed's own code, or comes from a third-party
# Composer package (named, with a note if that package isn't actually in
# composer.json/composer.lock — i.e. the file is vestigial/opt-in), an
# "Options:" line for booleans and enum-style values listing every
# accepted value, and the default used when unset. Comma separated lists
# have no surrounding spaces unless stated otherwise.
##############################################################################

# ----------------------------------------------------------------------------
# Application  [config/app.php]  — Laravel core
# ----------------------------------------------------------------------------

# Application Name
# This value is the name of your application. This value is used when the
# framework needs to place the application's name in a notification or any other
# location as required by the application or its packages.
# Used by 7 config files:
#   - app.php -> name [Laravel core]
#   - backup.php -> backup.name, monitor_backups.name [Package (spatie/laravel-backup)]
#   - cache.php -> prefix [Laravel core]
#   - database.php -> redis.options.prefix [Laravel core]
#   - logging.php -> channels.slack.username [Laravel core]
#   - mail.php -> from.name [Laravel core]
#   - websockets.php -> apps.name [Package (beyondcode/laravel-websockets) — not installed by default]
# APP_NAME=Pixelfed

# Application Environment
# This value determines the "environment" your application is currently running
# in. This may determine how you prefer to configure various services your
# application utilizes. Set this in your ".env" file.
# Used by 2 config files:
#   - app.php -> env [Laravel core]
#   - websockets.php -> ssl.verify_peer, ssl.allow_self_signed [Package (beyondcode/laravel-websockets) — not installed by default]
# Options: local | production
# APP_ENV=production

# Application Debug Mode
# When your application is in debug mode, detailed error messages with stack
# traces will be shown on every error that occurs within your application. If
# disabled, a simple generic error page is shown.
# Key: app.php -> debug
# Origin: Laravel core
# Options: true | false
# APP_DEBUG=false

# Application URL
# This URL is used by the console to properly generate URLs when using the
# Artisan command line tool. You should set this to the root of your application
# so that it is used when running Artisan tasks.
# Used by 3 config files (all Laravel core):
#   - app.php -> url
#   - filesystems.php -> disks.public.url
#   - mail.php -> mailers.smtp.local_domain
# APP_URL=https://localhost

# Application Locale Configuration
# The application locale determines the default locale that will be used by the
# translation service provider. You are free to set this value to any of the
# locales which will be supported by the application.
# Key: app.php -> locale
# Origin: Laravel core
# APP_LOCALE=en

# Application Fallback Locale
# The fallback locale determines the locale to use when the current one is not
# available. You may change the value to correspond to any of the language
# folders that are provided through your application.
# Key: app.php -> fallback_locale
# Origin: Laravel core
# APP_FALLBACK_LOCALE=en

# Encryption Key
# This key is used by the Illuminate encrypter service and should be set to a
# random, 32 character string, otherwise these encrypted strings will not be
# safe. Please do this before deploying an application!
# Key: app.php -> key
# Origin: Laravel core
# APP_KEY=

# Previous Encryption Keys
# Comma separated list of previous APP_KEY values, used to decrypt data during
# key rotation.
# Key: app.php -> previous_keys
# Origin: Laravel core
# APP_PREVIOUS_KEYS=""

# Maintenance Mode Driver
# These configuration options determine the driver used to determine and manage
# Laravel's "maintenance mode" status. The "cache" driver will allow maintenance
# mode to be controlled across multiple machines. Supported drivers: "file",
# "cache"
# Key: app.php -> maintenance.driver
# Origin: Laravel core
# Options: file | cache
# APP_MAINTENANCE_DRIVER=file
# Key: app.php -> maintenance.store
# Origin: Laravel core
# Options: apc | array | database | file | storage | memcached | redis | dynamodb | octane | failover
# APP_MAINTENANCE_STORE=database

# Short Instance Description
# A short tagline for the instance, shown in compact UI contexts.
# Key: app.php -> short_description
# Origin: Laravel core
# PF_SHORT_DESCRIPTION="Pixelfed is an image sharing platform, an ethical alternative to centralized platforms."

# Instance Description
# Longer description of the instance shown on the about/landing page.
# Key: app.php -> description
# Origin: Laravel core
# PF_DESCRIPTION="Pixelfed is an image sharing platform, an ethical alternative to centralized platforms."

# Instance Rules
# Instance rules shown to users, typically newline or pipe separated depending
# on template.
# Key: app.php -> rules
# Origin: Laravel core
# PF_RULES=

# Developer Logging
# Enable verbose developer-focused logging. Development use only.
# Key: app.php -> dev_log
# Origin: Laravel core
# Options: true | false
# PIXELFED_DEV_LOG=false

# ----------------------------------------------------------------------------
# Pixelfed Core Settings  [config/pixelfed.php]  — Pixelfed
# ----------------------------------------------------------------------------

# Enable Autospam
# Autospam uses NLP and other techniques to detect and mitigate potential spam
# posts from users on your server. We recommend enabling this when you have open
# registrations, regardless of how many users you have.
# Used by 2 config files (all Pixelfed):
#   - autospam.php -> enabled
#   - pixelfed.php -> bouncer.enabled
# Options: true | false
# PF_BOUNCER_ENABLED=false

# Image Quality
# Set the image optimization quality, must be a value between 1-100.
# Used by 2 config files:
#   - image-optimizer.php -> optimizers [Package (spatie/laravel-image-optimizer)]
#   - pixelfed.php -> image_quality [Pixelfed]
# IMAGE_QUALITY=80

# Enable Cloud Storage
# Store media on object storage like S3, Digital Ocean Spaces, Rackspace
# Used by 2 config files (all Pixelfed):
#   - import.php -> instagram.storage.cloud.enabled
#   - pixelfed.php -> cloud_storage
# Options: true | false
# PF_ENABLE_CLOUD=false

# Domains
# Application domains used for routing
# Used by 3 config files:
#   - livestreaming.php -> server.host [Pixelfed]
#   - pixelfed.php -> domain.app [Pixelfed]
#   - session.php -> domain [Laravel core]
# APP_DOMAIN=
# Key: pixelfed.php -> domain.admin
# Origin: Pixelfed
# ADMIN_DOMAIN=

# PHP/ImageMagic/GD Memory Limit
# This memory_limit value is only used for image processing. The default
# memory_limit php.ini is used for the rest of the app.
# Key: pixelfed.php -> memory_limit
# Origin: Pixelfed
# MEMORY_LIMIT=1024M

# Allow New Registrations
# Enable/disable new local account registrations.
# Key: pixelfed.php -> open_registration
# Origin: Pixelfed
# Options: true | false
# OPEN_REGISTRATION=true

# Account file size limit
# Update the max account size, the per user limit of files in KB.
# Key: pixelfed.php -> max_account_size
# Origin: Pixelfed
# MAX_ACCOUNT_SIZE=1000000

# Photo file size limit
# Update the max photo size, in KB.
# Key: pixelfed.php -> max_photo_size
# Origin: Pixelfed
# MAX_PHOTO_SIZE=15000

# Avatar file size limit
# Update the max avatar size, in KB.
# Key: pixelfed.php -> max_avatar_size
# Origin: Pixelfed
# MAX_AVATAR_SIZE=2000

# Caption limit
# Change the caption length limit for new local posts.
# Key: pixelfed.php -> max_caption_length
# Origin: Pixelfed
# MAX_CAPTION_LENGTH=500

# Bio length limit
# Change the bio length limit for user profiles.
# Key: pixelfed.php -> max_bio_length
# Origin: Pixelfed
# MAX_BIO_LENGTH=125

# User name length limit
# Change the length limit for user names.
# Key: pixelfed.php -> max_name_length
# Origin: Pixelfed
# MAX_NAME_LENGTH=30

# Password minimum length limit
# Change the minimum length limit for user passwords.
# Key: pixelfed.php -> min_password_length
# Origin: Pixelfed
# MIN_PASSWORD_LENGTH=8

# Album size limit
# The max number of photos allowed per post.
# Key: pixelfed.php -> max_album_length
# Origin: Pixelfed
# MAX_ALBUM_LENGTH=4

# Email Verification
# Require email verification before a new user can do anything.
# Key: pixelfed.php -> enforce_email_verification
# Origin: Pixelfed
# Options: true | false
# ENFORCE_EMAIL_VERIFICATION=true

# Account deletion
# Enable account deletion.
# Key: pixelfed.php -> account_deletion
# Origin: Pixelfed
# Options: true | false
# ACCOUNT_DELETION=true

# Account deletion after X days
# Set account deletion queue after X days, set to false to delete accounts
# immediately.
# Key: pixelfed.php -> account_delete_after
# Origin: Pixelfed
# Options: true | false
# ACCOUNT_DELETE_AFTER=false

# Max User Limit
# Allow a maximum number of user accounts. Default: enabled w/ 1000 max users
# Key: pixelfed.php -> max_users
# Origin: Pixelfed
# PF_MAX_USERS=1000

# Enforce Max User Limit
# Enforce the PF_MAX_USERS limit by blocking new registrations once reached.
# Key: pixelfed.php -> enforce_max_users
# Origin: Pixelfed
# Options: true | false
# PF_ENFORCE_MAX_USERS=true

# Optimize Images
# Resize and optimize image uploads. Default: on
# Key: pixelfed.php -> optimize_image
# Origin: Pixelfed
# Options: true | false
# PF_OPTIMIZE_IMAGES=true

# Optimize Videos
# Resize and optimize video uploads. Default: on
# Key: pixelfed.php -> optimize_video
# Origin: Pixelfed
# Options: true | false
# PF_OPTIMIZE_VIDEOS=true

# User invites
# Allow users to invite others via email. Will respect max user limit and
# prevent invites after the limit is reached. Default: off
# Key: pixelfed.php -> user_invites.enabled
# Origin: Pixelfed
# Options: true | false
# PF_USER_INVITES=false
# Key: pixelfed.php -> user_invites.limit.total
# Origin: Pixelfed
# PF_USER_INVITES_TOTAL_LIMIT=0
# Key: pixelfed.php -> user_invites.limit.daily
# Origin: Pixelfed
# PF_USER_INVITES_DAILY_LIMIT=0
# Key: pixelfed.php -> user_invites.limit.monthly
# Origin: Pixelfed
# PF_USER_INVITES_MONTHLY_LIMIT=0

# Max Collection Length
# Maximum number of posts allowed in a single collection.
# Key: pixelfed.php -> max_collection_length
# Origin: Pixelfed
# PF_MAX_COLLECTION_LENGTH=100

# Allowed Media MIME Types
# Comma separated list of MIME types accepted for media uploads.
# Key: pixelfed.php -> media_types
# Origin: Pixelfed
# MEDIA_TYPES=image/jpeg,image/jpg,image/png,image/gif

# Enforce Account Storage Limit
# Enforce the MAX_ACCOUNT_SIZE per-user storage limit.
# Key: pixelfed.php -> enforce_account_limit
# Origin: Pixelfed
# Options: true | false
# LIMIT_ACCOUNT_SIZE=true

# Instagram Import
# Allow users to import their data from Instagram.
# Key: pixelfed.php -> import.instagram.enabled
# Origin: Pixelfed
# Options: true | false
# IMPORT_INSTAGRAM=false

# Instagram Import Post Limit
# Maximum number of posts imported per Instagram import job.
# Key: pixelfed.php -> import.instagram.limits.posts
# Origin: Pixelfed
# IMPORT_INSTAGRAM_POST_LIMIT=100

# Instagram Import Size Limit
# Maximum total import size, in MB, per Instagram import job.
# Key: pixelfed.php -> import.instagram.limits.size
# Origin: Pixelfed
# IMPORT_INSTAGRAM_SIZE_LIMIT=5000

# OAuth
# Enable OAuth application support (third-party API clients).
# Key: pixelfed.php -> oauth_enabled
# Origin: Pixelfed
# Options: true | false
# OAUTH_ENABLED=true

# Bouncer: Ban Cloud Logins
# Block login attempts originating from known cloud/datacenter IP ranges.
# Key: pixelfed.php -> bouncer.cloud_ips.ban_logins
# Origin: Pixelfed
# Options: true | false
# PF_BOUNCER_BAN_CLOUD_LOGINS=false

# Bouncer: Ban Cloud Signups
# Block registrations originating from known cloud/datacenter IP ranges.
# Key: pixelfed.php -> bouncer.cloud_ips.ban_signups
# Origin: Pixelfed
# Options: true | false
# PF_BOUNCER_BAN_CLOUD_SIGNUPS=false

# Bouncer: Ban Cloud API Access
# Block API access originating from known cloud/datacenter IP ranges.
# Key: pixelfed.php -> bouncer.cloud_ips.ban_api
# Origin: Pixelfed
# Options: true | false
# PF_BOUNCER_BAN_CLOUD_API=false

# Bouncer: Strict Cloud API Mode
# Apply stricter matching when blocking API access from cloud/datacenter IP
# ranges.
# Key: pixelfed.php -> bouncer.cloud_ips.ban_api_strict_mode
# Origin: Pixelfed
# Options: true | false
# PF_BOUNCER_BAN_CLOUD_API_STRICT_MODE=false

# Media Fast Process
# Don't require photos & video to finish optimization & upload to S3 if enabled
# before posting. If disabled users will have to wait until processed before
# posting, sacrificing the user experience to ensure media is federated using S3
# urls (if enabled). Default: off
# Key: pixelfed.php -> media_fast_process
# Origin: Pixelfed
# Options: true | false
# PF_MEDIA_FAST_PROCESS=true

# Max Alt Text Length
# Maximum character length for media alt text/descriptions.
# Key: pixelfed.php -> max_altext_length
# Origin: Pixelfed
# PF_MEDIA_MAX_ALTTEXT_LENGTH=1000

# Allow OAuth App Registration
# Allow users to register their own third-party OAuth applications.
# Key: pixelfed.php -> allow_app_registration
# Origin: Pixelfed
# Options: true | false
# PF_ALLOW_APP_REGISTRATION=true

# App Registration Rate Limit Attempts
# Maximum OAuth app registration attempts per decay window.
# Key: pixelfed.php -> app_registration_rate_limit_attempts
# Origin: Pixelfed
# PF_IAR_RL_ATTEMPTS=3

# App Registration Rate Limit Decay
# Decay window, in seconds, for the OAuth app registration rate limit.
# Key: pixelfed.php -> app_registration_rate_limit_decay
# Origin: Pixelfed
# PF_IAR_RL_DECAY=1800

# App Registration Confirm Rate Limit Attempts
# Maximum OAuth app registration confirmation attempts per decay window (also
# governs the decay window, reused by config).
# Key: pixelfed.php -> app_registration_confirm_rate_limit_attempts, app_registration_confirm_rate_limit_decay
# Origin: Pixelfed
# PF_IARC_RL_ATTEMPTS=20

# ----------------------------------------------------------------------------
# Instance Settings  [config/instance.php]  — Pixelfed
# ----------------------------------------------------------------------------

# Network (Federated) Timeline
# Enable the network/federated timeline. Required before
# INSTANCE_NETWORK_TIMELINE_CACHED has any effect.
# Used by 2 config files (all Pixelfed):
#   - federation.php -> network_timeline
#   - instance.php -> timeline.network.cached
# PF_NETWORK_TIMELINE=

# Force HTTPS URLs
# Force all generated URLs (assets, media, links) to use https:// regardless of
# the request scheme.
# Key: instance.php -> force_https_urls
# Origin: Pixelfed
# Options: true | false
# FORCE_HTTPS_URLS=true

# Instance Description
# Short description of your instance shown in nodeinfo, the API, and instance
# metadata.
# Key: instance.php -> description
# Origin: Pixelfed
# INSTANCE_DESCRIPTION="Pixelfed - Photo sharing for everyone"

# Contact Form
# Enable the public 'contact us' form.
# Key: instance.php -> contact.enabled
# Origin: Pixelfed
# Options: true | false
# INSTANCE_CONTACT_FORM=false

# Contact Form Rate Limit
# Maximum number of contact form submissions accepted per IP per day.
# Key: instance.php -> contact.max_per_day
# Origin: Pixelfed
# INSTANCE_CONTACT_MAX_PER_DAY=1

# Public Discover Page
# Allow logged-out visitors to view the Discover page.
# Key: instance.php -> discover.public
# Origin: Pixelfed
# Options: true | false
# INSTANCE_DISCOVER_PUBLIC=false

# Public Hashtag Pages
# Allow logged-out visitors to view hashtag pages.
# Key: instance.php -> discover.tags.is_public
# Origin: Pixelfed
# Options: true | false
# INSTANCE_PUBLIC_HASHTAGS=false

# Beagle API for Discover
# Use pixelfed.org's Beagle API to power Discover suggestions.
# Key: instance.php -> discover.beagle_api
# Origin: Pixelfed
# Options: true | false
# PF_INSTANCE_USE_BEAGLE_API=true

# Contact Email
# Public contact email address shown to visitors and used for the contact form.
# Key: instance.php -> email
# Origin: Pixelfed
# INSTANCE_CONTACT_EMAIL=

# Home Timeline Caching
# Cache each user's home timeline for faster loads. Disabled by default.
# Key: instance.php -> timeline.home.cached
# Origin: Pixelfed
# Options: true | false
# PF_HOME_TIMELINE_CACHE=false

# Home Timeline Cache TTL
# Home timeline cache lifetime, in seconds.
# Key: instance.php -> timeline.home.cache_ttl
# Origin: Pixelfed
# PF_HOME_TIMELINE_CACHE_TTL=900

# Local Timeline Caching
# Cache the local (instance) public timeline.
# Key: instance.php -> timeline.local.cached
# Origin: Pixelfed
# Options: true | false
# INSTANCE_PUBLIC_TIMELINE_CACHED=false

# Public Local Timeline
# Allow logged-out visitors to view the local public timeline.
# Key: instance.php -> timeline.local.is_public
# Origin: Pixelfed
# Options: true | false
# INSTANCE_PUBLIC_LOCAL_TIMELINE=false

# Network Timeline Caching
# Cache the network (federated) timeline. Only applies when PF_NETWORK_TIMELINE
# is enabled.
# Key: instance.php -> timeline.network.cached
# Origin: Pixelfed
# Options: true | false
# INSTANCE_NETWORK_TIMELINE_CACHED=false

# Network Timeline Cache Size
# Maximum number of posts kept in the network timeline cache.
# Key: instance.php -> timeline.network.cache_dropoff
# Origin: Pixelfed
# INSTANCE_NETWORK_TIMELINE_CACHE_DROPOFF=100

# Network Timeline Max Post Age
# Maximum age, in hours, of a remote post eligible for the network timeline
# cache.
# Key: instance.php -> timeline.network.max_hours_old
# Origin: Pixelfed
# INSTANCE_NETWORK_TIMELINE_CACHE_MAX_HOUR_INGEST=2160

# 404 Page Heading
# Heading text shown on the custom 404 (not found) error page.
# Key: instance.php -> page.404.header
# Origin: Pixelfed
# PAGE_404_HEADER="Sorry, this page isn't available."

# 404 Page Body
# Body text (HTML allowed) shown on the custom 404 (not found) error page.
# Key: instance.php -> page.404.body
# Origin: Pixelfed
# PAGE_404_BODY="The link you followed may be broken, or the page may have been removed. <a href=\"/\">Go back to Pixelfed.</a>"

# 503 Page Heading
# Heading text shown on the custom 503 (maintenance mode) error page.
# Key: instance.php -> page.503.header
# Origin: Pixelfed
# PAGE_503_HEADER="Service Unavailable"

# 503 Page Body
# Body text (HTML allowed) shown on the custom 503 (maintenance mode) error
# page.
# Key: instance.php -> page.503.body
# Origin: Pixelfed
# PAGE_503_BODY="Our service is in maintenance mode, please try again later."

# Banned Usernames
# Comma separated list of usernames that cannot be registered.
# Key: instance.php -> username.banned
# Origin: Pixelfed
# BANNED_USERNAMES=

# Remote Username Display Format
# How remote (federated) usernames are displayed. One of: @ (user@domain), from
# (user from domain), custom.
# Key: instance.php -> username.remote.format
# Origin: Pixelfed
# Options: @ | from | custom
# USERNAME_REMOTE_FORMAT=@

# Remote Username Custom Separator
# Custom separator text used when USERNAME_REMOTE_FORMAT=custom.
# Key: instance.php -> username.remote.custom
# Origin: Pixelfed
# USERNAME_REMOTE_CUSTOM_TEXT=

# Stories
# Enable ephemeral Stories support.
# Key: instance.php -> stories.enabled
# Origin: Pixelfed
# Options: true | false
# STORIES_ENABLED=false

# Restricted Instance
# Mark this instance as restricted (limited/age-restricted) for discovery
# purposes.
# Key: instance.php -> restricted.enabled
# Origin: Pixelfed
# Options: true | false
# RESTRICTED_INSTANCE=false

# OAuth Access Token Lifetime
# Number of days an issued OAuth access token remains valid.
# Key: instance.php -> oauth.token_expiration
# Origin: Pixelfed
# OAUTH_TOKEN_DAYS=365

# OAuth Refresh Token Lifetime
# Number of days an issued OAuth refresh token remains valid.
# Key: instance.php -> oauth.refresh_expiration
# Origin: Pixelfed
# OAUTH_REFRESH_DAYS=400

# OAuth Personal Access Tokens
# Allow users to generate personal access tokens from their account settings.
# Key: instance.php -> oauth.pat_enabled
# Origin: Pixelfed
# Options: true | false
# OAUTH_PAT_ENABLED=false

# Config Cache Notice
# Show an admin warning to run `php artisan config:cache` when config caching
# would help performance.
# Key: instance.php -> enable_cc
# Origin: Pixelfed
# Options: true | false
# ENABLE_CONFIG_CACHE=true

# Legal Notice
# Show a legal notice/disclaimer link in the site footer.
# Key: instance.php -> has_legal_notice
# Origin: Pixelfed
# Options: true | false
# INSTANCE_LEGAL_NOTICE=false

# Profile Embeds
# Allow profiles to be embedded on external sites via iframe.
# Key: instance.php -> embed.profile
# Origin: Pixelfed
# Options: true | false
# INSTANCE_PROFILE_EMBEDS=true

# Post Embeds
# Allow posts to be embedded on external sites via iframe.
# Key: instance.php -> embed.post
# Origin: Pixelfed
# Options: true | false
# INSTANCE_POST_EMBEDS=true

# Hide Sensitive Media on Public Feeds
# Hide posts marked sensitive/NSFW from logged-out/public feeds.
# Key: instance.php -> hide_nsfw_on_public_feeds
# Origin: Pixelfed
# Options: true | false
# PF_HIDE_NSFW_ON_PUBLIC_FEEDS=false

# Store Avatars on Cloud Storage
# Upload locally generated avatars to cloud storage instead of the local disk.
# Key: instance.php -> avatar.local_to_cloud
# Origin: Pixelfed
# Options: true | false
# PF_LOCAL_AVATAR_TO_CLOUD=false

# Admin Invites
# Allow admins to generate invite links from the admin panel.
# Key: instance.php -> admin_invites.enabled
# Origin: Pixelfed
# Options: true | false
# PF_ADMIN_INVITES_ENABLED=true

# Max User Blocks
# Maximum number of accounts a single user can block.
# Key: instance.php -> user_filters.max_user_blocks
# Origin: Pixelfed
# PF_MAX_USER_BLOCKS=200

# Max User Mutes
# Maximum number of accounts a single user can mute.
# Key: instance.php -> user_filters.max_user_mutes
# Origin: Pixelfed
# PF_MAX_USER_MUTES=500

# Max Domain Blocks
# Maximum number of domains a single user can block.
# Key: instance.php -> user_filters.max_domain_blocks
# Origin: Pixelfed
# PF_MAX_DOMAIN_BLOCKS=100

# Report Email Notifications
# Send an email notification to admins when a new moderation report is filed.
# Key: instance.php -> reports.email.enabled
# Origin: Pixelfed
# Options: true | false
# INSTANCE_REPORTS_EMAIL_ENABLED=false

# Report Email Recipients
# Comma separated list of email addresses to notify of new reports.
# Key: instance.php -> reports.email.to
# Origin: Pixelfed
# INSTANCE_REPORTS_EMAIL_ADDRESSES=

# Report Email for Auto-Spam
# Include automatically generated (autospam) reports in report email
# notifications.
# Key: instance.php -> reports.email.autospam
# Origin: Pixelfed
# Options: true | false
# INSTANCE_REPORTS_EMAIL_AUTOSPAM=false

# Landing Page: Show Directory
# Show the user directory link on the logged-out landing page.
# Key: instance.php -> landing.show_directory
# Origin: Pixelfed
# Options: true | false
# INSTANCE_LANDING_SHOW_DIRECTORY=true

# Landing Page: Show Explore
# Show the Explore link on the logged-out landing page.
# Key: instance.php -> landing.show_explore
# Origin: Pixelfed
# Options: true | false
# INSTANCE_LANDING_SHOW_EXPLORE=true

# Instance Banner Blurhash
# Blurhash placeholder value used while the instance banner image loads.
# Key: instance.php -> banner.blurhash
# Origin: Pixelfed
# INSTANCE_BANNER_BLURHASH=UzJR]l{wHZRjM}R%XRkCH?X9xaWEjZj]kAjt

# Parental Controls
# Enable parental control / supervised account features.
# Key: instance.php -> parental_controls.enabled
# Origin: Pixelfed
# Options: true | false
# INSTANCE_PARENTAL_CONTROLS=false

# Parental Controls Respect Open Registration
# Require open registration before allowing supervised child accounts to be
# created.
# Key: instance.php -> parental_controls.limits.respect_open_registration
# Origin: Pixelfed
# Options: true | false
# INSTANCE_PARENTAL_CONTROLS_RESPECT_OPENREG=true

# Parental Controls Max Children
# Maximum number of supervised child accounts a parent account may manage.
# Key: instance.php -> parental_controls.limits.max_children
# Origin: Pixelfed
# INSTANCE_PARENTAL_CONTROLS_MAX_CHILDREN=1

# Suppress Update-Check Warning
# Suppress the admin dashboard warning shown when the software update check
# fails.
# Key: instance.php -> software-update.disable_failed_warning
# Origin: Pixelfed
# Options: true | false
# INSTANCE_SOFTWARE_UPDATE_DISABLE_FAILED_WARNING=false

# Notification Auto Garbage Collection
# Automatically delete old notifications after
# INSTANCE_NOTIFY_AUTO_GC_DEL_AFTER_DAYS days.
# Key: instance.php -> notifications.gc.enabled
# Origin: Pixelfed
# Options: true | false
# INSTANCE_NOTIFY_AUTO_GC=false

# Notification GC Retention
# Number of days to retain notifications before automatic garbage collection
# deletes them.
# Key: instance.php -> notifications.gc.delete_after_days
# Origin: Pixelfed
# INSTANCE_NOTIFY_AUTO_GC_DEL_AFTER_DAYS=365

# App Notification Gateway
# Enable delivery of push notifications through pixelfed.org's notification app
# gateway.
# Key: instance.php -> notifications.nag.enabled
# Origin: Pixelfed
# Options: true | false
# INSTANCE_NOTIFY_APP_GATEWAY=true

# Push Gateway API Key
# API key for the pixelfed.org push notification gateway.
# Key: instance.php -> notifications.nag.api_key
# Origin: Pixelfed
# Options: true | false
# PIXELFED_PUSHGATEWAY_KEY=false

# Curated Registration
# Enable curated (manually reviewed) registration, where new signups require
# admin approval.
# Key: instance.php -> curated_registration.enabled
# Origin: Pixelfed
# Options: true | false
# INSTANCE_CUR_REG=false

# Curated Registration Resend Limit
# Maximum number of times a pending applicant can request confirmation emails to
# be resent.
# Key: instance.php -> curated_registration.resend_confirmation_limit
# Origin: Pixelfed
# INSTANCE_CUR_REG_RESEND_LIMIT=5

# Curated Registration CAPTCHA
# Require a CAPTCHA on the curated registration application form. Falls back to
# CAPTCHA_ENABLED.
# Key: instance.php -> curated_registration.captcha_enabled
# Origin: Pixelfed
# Default is computed at runtime; see config/instance.php for details.
# INSTANCE_CUR_REG_CAPTCHA=

# Curated Registration Only on Closed Reg
# Only enable curated registration state handling when open registration is
# closed.
# Key: instance.php -> curated_registration.state.only_enabled_on_closed_reg
# Origin: Pixelfed
# Options: true | false
# INSTANCE_CUR_REG_STATE_ONLY_ON_CLOSED=true

# Notify Admins on Applicant Verification
# Email admins when a curated registration applicant verifies their email.
# Key: instance.php -> curated_registration.notify.admin.on_verify_email.enabled
# Origin: Pixelfed
# Options: true | false
# INSTANCE_CUR_REG_NOTIFY_ADMIN_ON_VERIFY=false

# Bundle Admin Verification Notices
# Bundle multiple applicant-verified notifications into a single digest email.
# Key: instance.php -> curated_registration.notify.admin.on_verify_email.bundle
# Origin: Pixelfed
# Options: true | false
# INSTANCE_CUR_REG_NOTIFY_ADMIN_ON_VERIFY_BUNDLE=false

# Max Admin Verification Notices/Day
# Maximum number of applicant-verified notification emails sent to admins per
# day.
# Key: instance.php -> curated_registration.notify.admin.on_verify_email.max_per_day
# Origin: Pixelfed
# INSTANCE_CUR_REG_NOTIFY_ADMIN_ON_VERIFY_MPD=10

# Curated Registration Notify Usernames
# Comma separated list of admin usernames to notify (e.g. 'admin,dansup,test').
# Key: instance.php -> curated_registration.notify.admin.on_verify_email.to_usernames
# Origin: Pixelfed
# INSTANCE_CUR_REG_NOTIFY_ADMIN_TO_USERNAMES=

# Curated Registration Notify CC
# Comma separated list of additional email addresses to CC on applicant
# notifications.
# Key: instance.php -> curated_registration.notify.admin.on_verify_email.cc_addresses
# Origin: Pixelfed
# INSTANCE_CUR_REG_NOTIFY_ADMIN_ON_VERIFY_CC=

# Notify Admins on Applicant Response
# Email admins when a curated registration applicant responds to a follow-up
# question.
# Key: instance.php -> curated_registration.notify.admin.on_user_response
# Origin: Pixelfed
# Options: true | false
# INSTANCE_CUR_REG_NOTIFY_ADMIN_ON_USER_RESPONSE=false

# Show Federated Peers
# Publicly list known federated peer instances via nodeinfo/API.
# Key: instance.php -> show_peers
# Origin: Pixelfed
# Options: true | false
# INSTANCE_SHOW_PEERS=false

# Allow DMs from New Accounts
# Allow accounts that don't follow each other to send direct messages.
# Key: instance.php -> allow_new_account_dms
# Origin: Pixelfed
# Options: true | false
# INSTANCE_ALLOW_NEW_DMS=true

# Estimate Total Post Count
# Use a fast estimated post count instead of an exact COUNT(*) query on high
# traffic instances.
# Key: instance.php -> total_count_estimate
# Origin: Pixelfed
# Options: true | false
# INSTANCE_TOTAL_POSTS_COUNT_ESTIMATE=false

# Admin Process ID
# Internal process id reference used by the admin panel. Leave unset.
# Key: instance.php -> admin.pid
# Origin: Pixelfed
# PF_ADMIN_PID=

# The maximum number of characters from a status that will be scanned
# for filter matching. Scanning too many characters can hurt performance, so
# this limit ensures that only the most relevant portion of a status is
# processed. For remote statuses, you might want to increase this value if you
# expect important content to appear later in long posts.
# Key: instance.php -> custom_filters.max_content_scan_limit
# Origin: Pixelfed
# PF_CF_CONTENT_SCAN_LIMIT=2500

# The maximum number of filters a single user can create.
# Limiting the number of filters per user helps prevent abuse and ensures that
# the filtering system remains performant.
# Key: instance.php -> custom_filters.max_filters_per_user
# Origin: Pixelfed
# PF_CF_MAX_FILTERS_PER_USER=20

# The maximum number of keywords that can be associated with a single filter.
# This limit helps control the complexity of the generated regular expressions
# and protects against potential performance issues during content scanning.
# Key: instance.php -> custom_filters.max_keywords_per_filter
# Origin: Pixelfed
# PF_CF_MAX_KEYWORDS_PER_FILTER=10

# The maximum length allowed for each keyword in a filter.
# Limiting keyword length not only curtails the size of the regex patterns
# created, but also guards against potential abuse where excessively long
# keywords might negatively impact matching performance or lead to unintended
# behavior.
# Key: instance.php -> custom_filters.max_keyword_length
# Origin: Pixelfed
# PF_CF_MAX_KEYWORD_LENGTH=40

# The maximum allowed length for the combined regex pattern.
# When constructing a regex that matches multiple filter keywords, each keyword
# (after escaping and adding boundaries) contributes to the total pattern
# length. This value is set to 10000 by default. If you increase either the
# number of keywords per filter or the maximum length allowed for each keyword,
# consider increasing this limit accordingly so that the final regex pattern can
# accommodate the additional length without being truncated or causing
# performance issues.
# Key: instance.php -> custom_filters.max_pattern_length
# Origin: Pixelfed
# PF_CF_MAX_PATTERN_LENGTH=10000

# The maximum number of keyword matches to report for a given status.
# When a filter is applied to a status, the matching process may find multiple
# occurrences of a keyword. This value limits the number of matches that are
# reported back, which helps manage output volume and processing overhead. The
# default is set to 10, but you can adjust this value through your environment
# configuration.
# Key: instance.php -> custom_filters.max_reported_matches
# Origin: Pixelfed
# PF_CF_MAX_REPORTED_MATCHES=10

# The maximum number of filter creation operations allowed per hour for a non-admin user.
# This rate limit prevents abuse by restricting how many filters a normal user
# can create within one hour. Admin users are exempt from this limit. Default is
# 20 creations per hour.
# Key: instance.php -> custom_filters.max_create_per_hour
# Origin: Pixelfed
# PF_CF_MAX_CREATE_PER_HOUR=20

# The maximum number of filter update operations allowed per hour for a non-admin user.
# This rate limit is designed to prevent abuse by limiting how many times a
# normal user can update their filters within one hour. Admin users are not
# subject to these limits. Default is 40 updates per hour.
# Key: instance.php -> custom_filters.max_updates_per_hour
# Origin: Pixelfed
# PF_CF_MAX_UPDATES_PER_HOUR=40

