# Origin: Laravel core
# REDIS_DATABASE=0

# DynamoDB Cache Table
# DynamoDB table name used when CACHE_STORE=dynamodb.
# Key: cache.php -> dynamodb.table
# Origin: Laravel core
# DYNAMODB_CACHE_TABLE=cache

# DynamoDB Endpoint
# Custom DynamoDB endpoint URL, e.g. for local DynamoDB testing.
# Key: cache.php -> dynamodb.endpoint
# Origin: Laravel core
# DYNAMODB_ENDPOINT=

# Cache Key Prefix
# When utilizing the APC, database, memcached, Redis, and DynamoDB cache stores,
# there might be other applications using the same cache. For that reason, you
# may prefix every cache key to avoid collisions.
# Key: cache.php -> prefix
# Origin: Laravel core
# Default is computed at runtime; see config/cache.php for details.
# CACHE_PREFIX=

# Rate Limiter Cache Store
# Cache store used by Laravel's rate limiter.
# Key: cache.php -> limiter
# Origin: Laravel core
# Options: apc | array | database | file | storage | memcached | redis | dynamodb | octane | failover
# CACHE_LIMITER_DRIVER=redis

# ----------------------------------------------------------------------------
# Queue  [config/queue.php]  — Laravel core
# ----------------------------------------------------------------------------

# Default Queue Connection Name
# Laravel's queue supports a variety of backends via a single, unified API,
# giving you convenient access to each backend using identical syntax for each.
# The default queue connection is defined below.
# Key: queue.php -> default
# Origin: Laravel core
# Options: sync | database | beanstalkd | sqs | redis | deferred | background | failover | null
# Default is computed at runtime; see config/queue.php for details.
# QUEUE_CONNECTION=

# Default Queue Connection Name
# Laravel's queue supports a variety of backends via a single, unified API,
# giving you convenient access to each backend using identical syntax for each.
# The default queue connection is defined below.
# Key: queue.php -> default
# Origin: Laravel core
# Options: sync | database | beanstalkd | sqs | redis | deferred | background | failover | null
# NOTE: Deprecated alias, prefer QUEUE_CONNECTION. Only used as a fallback
# when QUEUE_CONNECTION is not set.
# QUEUE_DRIVER=database

# Queue Connections
# Here you may configure the connection options for every queue backend used by
# your application. An example configuration is provided for each backend
# supported by Laravel. You're also free to add more. Drivers: "sync",
# "database", "beanstalkd", "sqs", "redis", "deferred", "background",
# "failover", "null"
# Key: queue.php -> connections.database.connection
# Origin: Laravel core
# DB_QUEUE_CONNECTION=
# Key: queue.php -> connections.database.table
# Origin: Laravel core
# DB_QUEUE_TABLE=jobs
# Key: queue.php -> connections.database.queue
# Origin: Laravel core
# DB_QUEUE=default
# Key: queue.php -> connections.database.retry_after
# Origin: Laravel core
# DB_QUEUE_RETRY_AFTER=90
# Key: queue.php -> connections.beanstalkd.host
# Origin: Laravel core
# BEANSTALKD_QUEUE_HOST=localhost
# Key: queue.php -> connections.beanstalkd.queue
# Origin: Laravel core
# BEANSTALKD_QUEUE=default
# Key: queue.php -> connections.beanstalkd.retry_after
# Origin: Laravel core
# BEANSTALKD_QUEUE_RETRY_AFTER=90
# Key: queue.php -> connections.sqs.prefix
# Origin: Laravel core
# SQS_PREFIX=https://sqs.us-east-1.amazonaws.com/your-account-id
# Key: queue.php -> connections.sqs.queue
# Origin: Laravel core
# SQS_QUEUE=default
# Key: queue.php -> connections.sqs.suffix
# Origin: Laravel core
# SQS_SUFFIX=
# Key: queue.php -> connections.redis.connection
# Origin: Laravel core
# REDIS_QUEUE_CONNECTION=default
# Key: queue.php -> connections.redis.queue
# Origin: Laravel core
# REDIS_QUEUE=default
# Key: queue.php -> connections.redis.retry_after
# Origin: Laravel core
# REDIS_QUEUE_RETRY_AFTER=330

# Failed Queue Jobs
# These options configure the behavior of failed queue job logging so you can
# control how and where failed jobs are stored. Laravel ships with support for
# storing failed jobs in a simple file or in a database. Supported drivers:
# "database-uuids", "dynamodb", "file", "null"
# Key: queue.php -> failed.driver
# Origin: Laravel core
# QUEUE_FAILED_DRIVER=database-uuids

# ----------------------------------------------------------------------------
# Horizon (Queue Dashboard)  [config/horizon.php]  — Package (laravel/horizon)
# ----------------------------------------------------------------------------

# Horizon Redis Prefix
# This prefix will be used when storing all Horizon data in Redis. You may
# modify the prefix when you are running multiple installations of Horizon on
# the same server so that they don't have problems.
# Key: horizon.php -> prefix
# Origin: Package (laravel/horizon)
# HORIZON_PREFIX=horizon-

# Notification Routing
# Horizon can notify you when a queue's LongWaitDetected threshold (see the
# `waits` option below) is exceeded. These are read by
# HorizonServiceProvider::boot() and are all optional; leave them unset to
# disable notification delivery entirely.
# Key: horizon.php -> notification_routing.mail_to
# Origin: Package (laravel/horizon)
# HORIZON_NOTIFICATIONS_MAIL=
# Key: horizon.php -> notification_routing.slack_webhook_url
# Origin: Package (laravel/horizon)
# HORIZON_NOTIFICATIONS_SLACK_WEBHOOK=
# Key: horizon.php -> notification_routing.slack_channel
# Origin: Package (laravel/horizon)
# HORIZON_NOTIFICATIONS_SLACK_CHANNEL=

# Memory Limit (MB)
# This value describes the maximum amount of memory the Horizon worker may
# consume before it is terminated and restarted. You should set this value
# according to the resources available to your server.
# Key: horizon.php -> memory_limit
# Origin: Package (laravel/horizon)
# HORIZON_MEMORY_LIMIT=64

# Queue Worker Configuration
# Here you may define the queue worker settings used by your application in all
# environments. These supervisors and settings handle all your queued jobs and
# will be provisioned by Horizon during deployment. Queues are split across
# supervisors by workload rather than lumped into one auto-balanced pool,
# because Horizon's `balance: auto` does not honor queue array order for
# priority - a burst on one queue can starve another sharing the same supervisor
# regardless of their names: - supervisor-priority: user-facing federation
# delivery (follows, deletes, DMs), inbox processing, and push notifications.
# These should never wait behind a burst of media processing or feed fanout. -
# supervisor-fanout: timeline/story/group fanout writes triggered by posts,
# likes, and follows. Bursty (one post can fan out to many followers) but not
# CPU-heavy. - supervisor-media: image/video optimization, resizing, and
# thumbnail generation (the `mmo` queue). CPU/IO heavy, so it runs a fixed
# worker pool (`balance: false`) instead of auto-scaling, which would otherwise
# let it claim workers away from the other pools under load. - supervisor-
# background: imports, instance crawling, account deletion/migration, and other
# maintenance work that isn't user-facing time-sensitive.
# Key: horizon.php -> defaults.supervisor-priority.balance, defaults.supervisor-fanout.balance, defaults.supervisor-background.balance
# Origin: Package (laravel/horizon)
# Options: simple | auto | false
# HORIZON_BALANCE_STRATEGY=auto
# Key: horizon.php -> defaults.supervisor-priority.minProcesses, defaults.supervisor-fanout.minProcesses, defaults.supervisor-media.minProcesses, defaults.supervisor-background.minProcesses
# Origin: Package (laravel/horizon)
# HORIZON_MIN_PROCESSES=1
# Key: horizon.php -> defaults.supervisor-priority.maxProcesses
# Origin: Package (laravel/horizon)
# HORIZON_MAX_PROCESSES=10
# Key: horizon.php -> defaults.supervisor-priority.memory, defaults.supervisor-fanout.memory, defaults.supervisor-media.memory, defaults.supervisor-background.memory
# Origin: Package (laravel/horizon)
# HORIZON_SUPERVISOR_MEMORY=64
# Key: horizon.php -> defaults.supervisor-priority.tries, defaults.supervisor-fanout.tries, defaults.supervisor-media.tries, defaults.supervisor-background.tries
# Origin: Package (laravel/horizon)
# HORIZON_SUPERVISOR_TRIES=3
# Key: horizon.php -> defaults.supervisor-priority.nice, defaults.supervisor-fanout.nice, defaults.supervisor-media.nice, defaults.supervisor-background.nice
# Origin: Package (laravel/horizon)
# HORIZON_SUPERVISOR_NICE=0
# Key: horizon.php -> defaults.supervisor-priority.timeout, defaults.supervisor-fanout.timeout, defaults.supervisor-media.timeout, defaults.supervisor-background.timeout
# Origin: Package (laravel/horizon)
# HORIZON_SUPERVISOR_TIMEOUT=300
# Key: horizon.php -> defaults.supervisor-fanout.maxProcesses
# Origin: Package (laravel/horizon)
# HORIZON_FANOUT_MAX_PROCESSES=6
# Key: horizon.php -> defaults.supervisor-media.maxProcesses
# Origin: Package (laravel/horizon)
# HORIZON_MEDIA_MAX_PROCESSES=4
# Key: horizon.php -> defaults.supervisor-background.maxProcesses
# Origin: Package (laravel/horizon)
# HORIZON_BACKGROUND_MAX_PROCESSES=4

# Horizon Dark Mode
# Use a dark theme for the Horizon dashboard.
# Key: horizon.php -> darkmode
# Origin: Package (laravel/horizon)
# Options: true | false
# HORIZON_DARKMODE=false

# ----------------------------------------------------------------------------
# Broadcasting  [config/broadcasting.php]  — Laravel core
# ----------------------------------------------------------------------------

# Default Broadcaster
# This option controls the default broadcaster that will be used by the
# framework when an event needs to be broadcast. You may set this to any of the
# connections defined in the "connections" array below. Supported: "reverb",
# "pusher", "ably", "redis", "log", "null"
# Key: broadcasting.php -> default
# Origin: Laravel core
# Options: reverb | pusher | redis | ably | log | null
# Default is computed at runtime; see config/broadcasting.php for details.
# BROADCAST_CONNECTION=

# Default Broadcaster
# This option controls the default broadcaster that will be used by the
# framework when an event needs to be broadcast. You may set this to any of the
# connections defined in the "connections" array below. Supported: "reverb",
# "pusher", "ably", "redis", "log", "null"
# Key: broadcasting.php -> default
# Origin: Laravel core
# Options: reverb | pusher | redis | ably | log | null
# NOTE: Deprecated alias, prefer BROADCAST_CONNECTION. Only used as a fallback
# when BROADCAST_CONNECTION is not set.
# BROADCAST_DRIVER=null

# Broadcast Connections
# Here you may define all of the broadcast connections that will be used to
# broadcast events to other systems or over WebSockets. Samples of each
# available type of connection are provided inside this array.
# Key: broadcasting.php -> connections.reverb.key
# Origin: Laravel core
# REVERB_APP_KEY=
# Key: broadcasting.php -> connections.reverb.secret
# Origin: Laravel core
# REVERB_APP_SECRET=
# Key: broadcasting.php -> connections.reverb.app_id
# Origin: Laravel core
# REVERB_APP_ID=
# Key: broadcasting.php -> connections.reverb.options.host
# Origin: Laravel core
# REVERB_HOST=
# Key: broadcasting.php -> connections.reverb.options.port
# Origin: Laravel core
# REVERB_PORT=443
# Key: broadcasting.php -> connections.reverb.options.scheme, connections.reverb.options.useTLS
# Origin: Laravel core
# REVERB_SCHEME=https
# Used by 2 config files:
#   - broadcasting.php -> connections.pusher.key [Laravel core]
#   - websockets.php -> apps.key [Package (beyondcode/laravel-websockets) — not installed by default]
# PUSHER_APP_KEY=
# Used by 2 config files:
#   - broadcasting.php -> connections.pusher.secret [Laravel core]
#   - websockets.php -> apps.secret [Package (beyondcode/laravel-websockets) — not installed by default]
# PUSHER_APP_SECRET=
# Used by 2 config files:
#   - broadcasting.php -> connections.pusher.app_id [Laravel core]
#   - websockets.php -> apps.id [Package (beyondcode/laravel-websockets) — not installed by default]
# PUSHER_APP_ID=
# Key: broadcasting.php -> connections.pusher.options.cluster, connections.pusher.options.host
# Origin: Laravel core
# PUSHER_APP_CLUSTER=
# Key: broadcasting.php -> connections.pusher.options.host
# Origin: Laravel core
# PUSHER_HOST=
# Key: broadcasting.php -> connections.pusher.options.port
# Origin: Laravel core
# PUSHER_PORT=443
# Key: broadcasting.php -> connections.pusher.options.scheme, connections.pusher.options.useTLS
# Origin: Laravel core
# PUSHER_SCHEME=https
# Key: broadcasting.php -> connections.pusher.options.encrypted
# Origin: Laravel core
# Options: true | false
# PUSHER_APP_ENCRYPTED=false
# Key: broadcasting.php -> connections.ably.key
# Origin: Laravel core
# ABLY_KEY=

# ----------------------------------------------------------------------------
# WebSockets (Laravel WebSockets / soketi)  [config/websockets.php]  — Package (beyondcode/laravel-websockets) — not installed by default
# ----------------------------------------------------------------------------

# Dashboard Settings
# You can configure the dashboard settings from here.
# Key: websockets.php -> dashboard.port
# Origin: Package (beyondcode/laravel-websockets) — not installed by default
# LARAVEL_WEBSOCKETS_PORT=6001
# Key: websockets.php -> dashboard.domain
# Origin: Package (beyondcode/laravel-websockets) — not installed by default
# LARAVEL_WEBSOCKETS_DOMAIN=
# Key: websockets.php -> dashboard.path
# Origin: Package (beyondcode/laravel-websockets) — not installed by default
# LARAVEL_WEBSOCKETS_PATH=laravel-websockets

# Applications Repository
# By default, the only allowed app is the one you define with your PUSHER_*
# variables from .env. You can configure to use multiple apps if you need to, or
# use a custom App Manager that will handle the apps from a database, per se.
# You can apply multiple settings, like the maximum capacity, enable client-to-
# client messages or statistics.
# Key: websockets.php -> apps.host
# Origin: Package (beyondcode/laravel-websockets) — not installed by default
# PUSHER_APP_HOST=
# Key: websockets.php -> apps.path
# Origin: Package (beyondcode/laravel-websockets) — not installed by default
# PUSHER_APP_PATH=

# Broadcasting Replication PubSub
# You can enable replication to publish and subscribe to messages across the
# driver. By default, it is set to 'local', but you can configure it to use
# drivers like Redis to ensure connection between multiple instances of
# WebSocket servers. Just set the driver to 'redis' to enable the PubSub using
# Redis.
# Key: websockets.php -> replication.mode
# Origin: Package (beyondcode/laravel-websockets) — not installed by default
# WEBSOCKETS_REPLICATION_MODE=local

# WebSockets Redis Replication Connection
# Redis connection name used to replicate WebSocket messages across multiple
# server instances.
# Key: websockets.php -> replication.modes.redis.connection
# Origin: Package (beyondcode/laravel-websockets) — not installed by default
# WEBSOCKETS_REDIS_REPLICATION_CONNECTION=default

# SSL Configuration
# By default, the configuration allows only on HTTP. For SSL, you need to set up
# the the certificate, the key, and optionally, the passphrase for the private
# key. You will need to restart the server for the settings to take place.
# Key: websockets.php -> ssl.local_cert
# Origin: Package (beyondcode/laravel-websockets) — not installed by default
# LARAVEL_WEBSOCKETS_SSL_LOCAL_CERT=
# Key: websockets.php -> ssl.capath
# Origin: Package (beyondcode/laravel-websockets) — not installed by default
# LARAVEL_WEBSOCKETS_SSL_CA=
# Key: websockets.php -> ssl.local_pk
# Origin: Package (beyondcode/laravel-websockets) — not installed by default
# LARAVEL_WEBSOCKETS_SSL_LOCAL_PK=
# Key: websockets.php -> ssl.passphrase
# Origin: Package (beyondcode/laravel-websockets) — not installed by default
# LARAVEL_WEBSOCKETS_SSL_PASSPHRASE=

# ----------------------------------------------------------------------------
# Mail  [config/mail.php]  — Laravel core
# ----------------------------------------------------------------------------

# Global "From" Address
# You may wish for all emails sent by your application to be sent from the same
# address. Here you may specify a name and address that is used globally for all
# emails that are sent by your application.
# Used by 2 config files:
#   - backup.php -> notifications.mail.from.address [Package (spatie/laravel-backup)]
#   - mail.php -> from.address [Laravel core]
# MAIL_FROM_ADDRESS=hello@example.com
# Used by 2 config files:
#   - backup.php -> notifications.mail.from.name [Package (spatie/laravel-backup)]
#   - mail.php -> from.name [Laravel core]
# Default is computed at runtime; see config/mail.php for details.
# MAIL_FROM_NAME=

# Default Mailer
# This option controls the default mailer that is used to send all email
# messages unless another mailer is explicitly specified when sending the
# message. All additional mailers can be configured within the "mailers" array.
# Examples of each type of mailer are provided.
# Key: mail.php -> default
# Origin: Laravel core
# Options: smtp | ses | mailgun | postmark | resend | sendmail | log | array | failover | roundrobin
# Default is computed at runtime; see config/mail.php for details.
# MAIL_MAILER=

# Default Mailer
# This option controls the default mailer that is used to send all email
# messages unless another mailer is explicitly specified when sending the
# message. All additional mailers can be configured within the "mailers" array.
# Examples of each type of mailer are provided.
# Key: mail.php -> default
# Origin: Laravel core
# Options: smtp | ses | mailgun | postmark | resend | sendmail | log | array | failover | roundrobin
# NOTE: Deprecated alias, prefer MAIL_MAILER. Only used as a fallback
# when MAIL_MAILER is not set.
# MAIL_DRIVER=smtp

# Mailer Configurations
# Here you may configure all of the mailers used by your application plus their
# respective settings. Several examples have been configured for you and you are
# free to add your own as your application requires. Laravel supports a variety
# of mail "transport" drivers that can be used when delivering an email. You may
# specify which one you're using for your mailers below. You may also add
# additional mailers if needed. Supported: "smtp", "sendmail", "mailgun", "ses",
# "ses-v2", "postmark", "resend", "log", "array", "failover", "roundrobin"
# Key: mail.php -> mailers.smtp.scheme
# Origin: Laravel core
# MAIL_SCHEME=
# Key: mail.php -> mailers.smtp.url
# Origin: Laravel core
# MAIL_URL=
# Key: mail.php -> mailers.smtp.host
# Origin: Laravel core
# MAIL_HOST=127.0.0.1
# Key: mail.php -> mailers.smtp.port
# Origin: Laravel core
# MAIL_PORT=2525
# Key: mail.php -> mailers.smtp.encryption
# Origin: Laravel core
# Options: tls | ssl | null
# MAIL_ENCRYPTION=tls
# Key: mail.php -> mailers.smtp.username
# Origin: Laravel core
# MAIL_USERNAME=
# Key: mail.php -> mailers.smtp.password
# Origin: Laravel core
# MAIL_PASSWORD=
# Key: mail.php -> mailers.smtp.local_domain
# Origin: Laravel core
# Default is computed at runtime; see config/mail.php for details.
# MAIL_EHLO_DOMAIN=
# Key: mail.php -> mailers.smtp.verify_peer
# Origin: Laravel core
# Options: true | false
# MAIL_SMTP_VERIFY_PEER=true
# Key: mail.php -> mailers.smtp.auto_tls
# Origin: Laravel core
# Options: true | false
# MAIL_AUTO_TLS=true
# Key: mail.php -> mailers.postmark.message_stream_id
# Origin: Laravel core
# POSTMARK_MESSAGE_STREAM_ID=
# Key: mail.php -> mailers.sendmail.path
# Origin: Laravel core
# MAIL_SENDMAIL_PATH="/usr/sbin/sendmail -bs -i"
# Key: mail.php -> mailers.log.channel
# Origin: Laravel core
# Options: stack | single | daily | slack | papertrail | stderr | syslog | errorlog | null | emergency | media
# MAIL_LOG_CHANNEL=

# ----------------------------------------------------------------------------
# Filesystems / Object Storage  [config/filesystems.php]  — Laravel core
# ----------------------------------------------------------------------------

# Filesystem Disks
# Here you may configure as many filesystem "disks" as you wish, and you may
# even configure multiple disks of the same driver. Defaults have been setup for
# each driver as an example of the required options. Supported Drivers: "local",
# "ftp", "sftp", "s3", "rackspace"
# Used by 3 config files (all Laravel core):
#   - cache.php -> dynamodb.key
#   - filesystems.php -> disks.s3.key
#   - queue.php -> connections.sqs.key
# AWS_ACCESS_KEY_ID=
# Used by 3 config files (all Laravel core):
#   - cache.php -> dynamodb.secret
#   - filesystems.php -> disks.s3.secret
#   - queue.php -> connections.sqs.secret
# AWS_SECRET_ACCESS_KEY=
# Used by 3 config files (all Laravel core):
#   - cache.php -> dynamodb.region
#   - filesystems.php -> disks.s3.region
#   - queue.php -> connections.sqs.region
# AWS_DEFAULT_REGION=

# Default Filesystem Disk
# Here you may specify the default filesystem disk that should be used by the
# framework. The "local" disk, as well as a variety of cloud based disks are
# available to your application. Just store away!
# Key: filesystems.php -> default
# Origin: Laravel core
# Options: local | public | s3 | alt-primary | alt-secondary | spaces | backup
# DANGEROUSLY_SET_FILESYSTEM_DRIVER=local

