# Custom Emoji
# Enable custom emoji support (upload and federation).
# Key: federation.php -> custom_emoji.enabled
# Origin: Pixelfed
# Options: true | false
# CUSTOM_EMOJI=false

# Custom Emoji Max Size
# Maximum file size, in bytes, for an uploaded custom emoji.
# Key: federation.php -> custom_emoji.max_size
# Origin: Pixelfed
# CUSTOM_EMOJI_MAX_SIZE=2000000

# Account Migration
# Allow users to migrate their account to/from another ActivityPub server.
# Key: federation.php -> migration
# Origin: Pixelfed
# Options: true | false
