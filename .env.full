# CORS  [config/cors.php]  — Laravel core
# ----------------------------------------------------------------------------

# Matches the request origin. `[*]` allows all origins. Wildcards can be used, eg `*.mydomain.com`
# Key: cors.php -> allowed_origins
# Origin: Laravel core
# PF_CORS_ALLOWED_ORIGINS=

