# =============================================================================
# Pixelfed .env.full — Comprehensive reference configuration
# =============================================================================
#
# PURPOSE
#   This file documents the environment variables an operator is expected to
#   set, with SAFE PRODUCTION DEFAULTS and the valid OPTIONS for each.
#   It is a REFERENCE, not a drop-in .env. Copy the sections you need into a
#   real .env, then fill in secrets and instance-specific values.
#
# CONVENTIONS
#   * Values shown are safe production defaults unless marked otherwise.
#   * "# options:" lists accepted values.
#   * Secrets are intentionally left BLANK — never commit real secrets.
#   * Boolean values are strings: "true" / "false".
#   * Defaults here mirror the app's config/*.php env() fallbacks. If a line is
#     commented out, the app already uses that value as its built-in default;
#     uncomment only to override.
#
# =============================================================================


# -----------------------------------------------------------------------------
# Core Application
# -----------------------------------------------------------------------------
APP_NAME="Pixelfed"
APP_ENV="production"                 # REQUIRED: production | local | staging
APP_KEY=                             # REQUIRED: Generate: php artisan key:generate
APP_URL="https://example.com"        # REQUIRED: Full public URL, no trailing slash
APP_DOMAIN="example.com"             # OPTIONAL: Falls back to host of APP_URL
ADMIN_DOMAIN="example.com"           # OPTIONAL: Falls back to host of APP_URL
TRUST_PROXIES="*"                    # OPTIONAL: "*" | comma-separated proxy IPs/CIDRs

# -----------------------------------------------------------------------------
# Setting Override
# -----------------------------------------------------------------------------
OPEN_REGISTRATION="false"            # options: true | false. Seeds the initial registration state; the admin panel toggle normally overrides it at runtime
ENFORCE_EMAIL_VERIFICATION="true"    # options: true | false

# INSTANCE_CUR_REG="false"           # curated registration flow. options: true | false
# PF_USER_INVITES="false"            # options: true | false
# PF_ADMIN_INVITES_ENABLED="true"
# PF_ALLOW_APP_REGISTRATION="true"   # allow signup via mobile apps
MIN_PASSWORD_LENGTH="8"


# -----------------------------------------------------------------------------
# Optional
# -----------------------------------------------------------------------------
APP_DEBUG="false"                    # options: true | false. MUST be false in production
APP_LOCALE="en"
APP_FALLBACK_LOCALE="en"
FORCE_HTTPS_URLS="true"              # options: true | false. Keep true behind TLS


# -----------------------------------------------------------------------------
# Instance Configuration
# -----------------------------------------------------------------------------
PF_MAX_USERS="1000"                  # max local accounts
PF_ENFORCE_MAX_USERS="true"          # options: true | false
ENABLE_CONFIG_CACHE="true"           # options: true | false. Keep true in production
RESTRICTED_INSTANCE="false"          # options: true | false. Require login to view content

INSTANCE_DESCRIPTION="Pixelfed - Photo sharing for everyone"
INSTANCE_CONTACT_EMAIL=              # public contact email
INSTANCE_DISCOVER_PUBLIC="true"      # options: true | false. Expose discover feed publicly
INSTANCE_PUBLIC_LOCAL_TIMELINE="false"   # options: true | false
INSTANCE_PUBLIC_HASHTAGS="false"     # options: true | false
INSTANCE_SHOW_PEERS="false"          # options: true | false
INSTANCE_CONTACT_FORM="false"        # options: true | false
INSTANCE_LANDING_SHOW_DIRECTORY="true"
INSTANCE_LANDING_SHOW_EXPLORE="true"
# INSTANCE_LEGAL_NOTICE="false"
# ACCOUNT_DELETION="true"            # options: true | false
# ACCOUNT_DELETE_AFTER="false"       # options: false | number of days

# -----------------------------------------------------------------------------
# Account Limits
# -----------------------------------------------------------------------------
MAX_PHOTO_SIZE="15000"               # per-file upload limit in KB (15000 = ~15MB)
MAX_ALBUM_LENGTH="4"                 # photos per post
MAX_CAPTION_LENGTH="500"
MAX_BIO_LENGTH="125"
MAX_NAME_LENGTH="30"
MAX_AVATAR_SIZE="2000"               # KB
LIMIT_ACCOUNT_SIZE="true"            # options: true | false
MAX_ACCOUNT_SIZE="1000000"           # total storage per account in KB (~1GB)
PF_MAX_COLLECTION_LENGTH="100"
PF_MAX_USER_BLOCKS="200"
PF_MAX_USER_MUTES="500"
PF_MAX_DOMAIN_BLOCKS="100"


# -----------------------------------------------------------------------------
# Media Handling
# -----------------------------------------------------------------------------
IMAGE_DRIVER="vips"                    # options: gd | imagick | vips
PF_OPTIMIZE_IMAGES="true"            # options: true | false
PF_OPTIMIZE_VIDEOS="true"            # options: true | false
IMAGE_QUALITY="80"                   # 1-100
IMAGE_STRIP="true"                   # strip EXIF/metadata. options: true | false
# IMAGE_BACKGROUNDCOLOR="ffffff"     # hex, no leading #
MEDIA_TYPES="image/jpeg,image/jpg,image/png,image/gif"   # add image/webp, video/mp4 as needed
PF_MEDIA_FAST_PROCESS="true"
PF_MEDIA_MAX_ALTTEXT_LENGTH="1000"
# MEDIA_EXIF_DATABASE="false"        # store EXIF in DB. options: true | false

# HLS / video streaming (advanced)
# MEDIA_HLS_ENABLED="false"
# MEDIA_HLS_BITRATE="1000"
# MEDIA_HLS_P2P="false"


# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
DB_CONNECTION="mysql"                # options: mysql | pgsql | sqlite | sqlsrv
DB_HOST="127.0.0.1"
DB_PORT="3306"                       # mysql:3306 | pgsql:5432 | sqlsrv:1433
DB_DATABASE="pixelfed"
DB_USERNAME="pixelfed"
DB_PASSWORD=                         # REQUIRED. Set a strong password
# DB_CHARSET="utf8mb4"
# DB_COLLATION="utf8mb4_unicode_ci"
# DB_URL=                            # optional full DSN, overrides discrete DB_* vars


# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------
REDIS_CLIENT="phpredis"              # options: phpredis (needs ext-redis) | predis
REDIS_SCHEME="tcp"                   # options: tcp | tls | unix
REDIS_HOST="127.0.0.1"
REDIS_PASSWORD=                      # leave blank if none; quote "null" only for legacy
REDIS_PORT="6379"
# REDIS_USERNAME=                    # ACL username (Redis 6+)
# REDIS_DATABASE="0"                 # default DB index
# REDIS_CACHE_DB="1"
# REDIS_PREFIX=                      # override key prefix (defaults to slug of APP_NAME)
# REDIS_URL=                         # optional full DSN


# -----------------------------------------------------------------------------
# Laravel Drivers (cache / queue / session / broadcast / logging)
# -----------------------------------------------------------------------------
CACHE_STORE="redis"                  # options: redis | file | database | memcached | array
QUEUE_CONNECTION="redis"             # options: redis | database | sqs | beanstalkd | sync
SESSION_DRIVER="database"            # options: database | redis | file | cookie
BROADCAST_CONNECTION="log"           # options: log | null | pusher | reverb | ably
HORIZON_PREFIX="horizon-"

LOG_CHANNEL="stack"                  # options: stack | single | daily | syslog | slack | stderr
LOG_LEVEL="critical"                 # options: debug | info | notice | warning | error | critical | alert | emergency
LOG_STACK="daily"                    # channels used by the "stack" channel
# LOG_DAILY_DAYS="14"
# LOG_SLACK_WEBHOOK_URL=             # required if LOG_CHANNEL=slack


# -----------------------------------------------------------------------------
# Session / Cookies
# -----------------------------------------------------------------------------
SESSION_LIFETIME="120"               # minutes
SESSION_SECURE_COOKIE="true"         # options: true | false. Keep true behind TLS
SESSION_HTTP_ONLY="true"
SESSION_SAME_SITE="lax"              # options: lax | strict | none
# SESSION_ENCRYPT="false"
# SESSION_DOMAIN=null                # null for apex (recommended). Set only for SSO/subdomain
# SESSION_COOKIE="pxfs"


# -----------------------------------------------------------------------------
# Mail
# -----------------------------------------------------------------------------
MAIL_MAILER="log"                    # options: log | smtp | sendmail | ses | mailgun | postmark | resend | array
MAIL_HOST="127.0.0.1"
MAIL_PORT="2525"                     # common: 587 (STARTTLS) | 465 (TLS) | 25
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION="tls"               # options: tls | ssl | null
MAIL_FROM_ADDRESS="pixelfed@example.com"
MAIL_FROM_NAME="Pixelfed"
MAIL_AUTO_TLS="true"                 # STARTTLS negotiation. options: true | false
# Provider-specific (set only for the matching MAIL_MAILER):
# MAILGUN_DOMAIN=
# MAILGUN_SECRET=
# POSTMARK_MESSAGE_STREAM_ID=
# RESEND_KEY=
# SES_KEY=
# SES_SECRET=
# SES_REGION="us-east-1"


# -----------------------------------------------------------------------------
# Cloud / Object Storage (S3-compatible)
# -----------------------------------------------------------------------------
PF_ENABLE_CLOUD="false"              # options: true | false. Master switch for cloud media
FILESYSTEM_CLOUD="s3"                # options: s3
MEDIA_DELETE_LOCAL_AFTER_CLOUD="true"    # remove local copy after upload. options: true | false
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=
# AWS_BUCKET=
# AWS_URL=                           # public base URL / CDN for objects
# AWS_ENDPOINT=                      # for non-AWS S3 (MinIO, Wasabi, R2, etc.)
# AWS_USE_PATH_STYLE_ENDPOINT="false"    # options: true | false (true for MinIO)
# AWS_VISIBILITY="public"            # options: public | private


# -----------------------------------------------------------------------------
# ActivityPub / Federation
# -----------------------------------------------------------------------------
ACTIVITY_PUB="false"                 # options: true | false. Master federation switch
AP_REMOTE_FOLLOW="true"              # options: true | false
AP_INBOX="true"                      # options: true | false
AP_OUTBOX="true"                     # options: true | false
AP_SHAREDINBOX="true"                # options: true | false
AUTHORIZED_FETCH="false"             # options: true | false. Secure-mode signed fetches
# ACTIVITYPUB_DELIVERY_TIMEOUT="30"  # seconds
# ACTIVITYPUB_DELIVERY_CONCURRENCY="10"
WEBFINGER="true"
NODEINFO="true"
ATOM_FEEDS="true"
REMOTE_AVATARS="true"                # options: true | false


# -----------------------------------------------------------------------------
# OAuth / API Tokens
# -----------------------------------------------------------------------------
OAUTH_ENABLED="true"                 # options: true | false
OAUTH_PAT_ENABLED="false"            # personal access tokens. options: true | false
# OAUTH_TOKEN_DAYS="365"
# OAUTH_REFRESH_DAYS="400"


# -----------------------------------------------------------------------------
# CAPTCHA (hCaptcha)
# -----------------------------------------------------------------------------
CAPTCHA_ENABLED="false"              # options: true | false
CAPTCHA_ENABLED_ON_REGISTER="false"  # options: true | false
CAPTCHA_ENABLED_ON_LOGIN="false"     # options: true | false
CAPTCHA_SITEKEY=                     # required if CAPTCHA_ENABLED=true
CAPTCHA_SECRET=                      # required if CAPTCHA_ENABLED=true
# CAPTCHA_TRIGGERS_LOGIN_ENABLED="false"
# CAPTCHA_TRIGGERS_LOGIN_ATTEMPTS="2"


# -----------------------------------------------------------------------------
# Instagram Import (optional)
# -----------------------------------------------------------------------------
# PF_IMPORT_FROM_INSTAGRAM="true"    # options: true | false
# PF_IMPORT_IG_MAX_POSTS="1000"
# PF_IMPORT_IG_ALLOW_VIDEO_POSTS="true"


# -----------------------------------------------------------------------------
# Experimental Features (opt-in; may be unstable)
# -----------------------------------------------------------------------------
EXP_EMC="true"                       # emoji/mention caching. options: true | false
# EXP_POLLS="false"                  # options: true | false
# EXP_GPS="false"                    # options: true | false
# STORIES_ENABLED="false"            # options: true | false
# CUSTOM_EMOJI="false"               # options: true | false


# -----------------------------------------------------------------------------
# Trending / Timeline Caching (performance)
# -----------------------------------------------------------------------------
# PF_NETWORK_TIMELINE="true"
# PF_HOME_TIMELINE_CACHE="false"
# PF_HASHTAGS_TRENDING_LIMIT="20"
# MEMORY_LIMIT="1024M"               # PHP memory for heavy jobs


# -----------------------------------------------------------------------------
# Backups (spatie/laravel-backup)
# -----------------------------------------------------------------------------
# PF_BACKUP_DRIVER="local"           # options: local | s3
# PF_BACKUP_BUCKET=
# PF_BACKUP_KEY=
# PF_BACKUP_SECRET=
# PF_BACKUP_REGION=
# PF_BACKUP_ENDPOINT=
# PF_BACKUP_ROOT="/"
