# PF_BACKUP_SECRET=
# Key: filesystems.php -> disks.backup.endpoint
# Origin: Laravel core
# PF_BACKUP_ENDPOINT=
# Key: filesystems.php -> disks.backup.region
# Origin: Laravel core
# PF_BACKUP_REGION=
# Key: filesystems.php -> disks.backup.bucket
# Origin: Laravel core
# PF_BACKUP_BUCKET=

# Default Filesystem Disk (Laravel Storage facade)
# The default filesystem disk used by Laravel's generic Storage facade. Pixelfed
# itself uses DANGEROUSLY_SET_FILESYSTEM_DRIVER/FILESYSTEM_CLOUD for media
# storage instead.
# Key: filesystems.php -> default
# Origin: Laravel core
# Options: local | public | s3 | alt-primary | alt-secondary | spaces | backup
# FILESYSTEM_DISK=local

# ----------------------------------------------------------------------------
# Media  [config/media.php]  — Pixelfed
# ----------------------------------------------------------------------------

# Delete Local Media After Cloud Upload
# Delete the local copy of media once it has been uploaded to cloud storage.
# Key: media.php -> delete_local_after_cloud
# Origin: Pixelfed
# Options: true | false
# MEDIA_DELETE_LOCAL_AFTER_CLOUD=true

# EXIF Database
# Store extracted EXIF metadata in the database.
# Key: media.php -> exif.database
# Origin: Pixelfed
# Options: true | false
# MEDIA_EXIF_DATABASE=false

# Store remote media on cloud/S3
# Set this to cache remote media on cloud/S3 filesystem drivers. Disabled by
# default.
# Key: media.php -> storage.remote.cloud
# Origin: Pixelfed
# Options: true | false
# MEDIA_REMOTE_STORE_CLOUD=false

# Catch Unoptimized Media
# Scan for and reprocess media older than this many hours that was never
# optimized. Set to false to disable.
# Key: media.php -> image_optimize.catch_unoptimized_media_hour_limit
# Origin: Pixelfed
# Options: true | false
# PF_CATCHUNOPTIMIZEDMEDIA=false

# Enable HLS
# Enable optional HLS support, required for video p2p support. Requires FFMPEG
# Disabled by default.
# Key: media.php -> hls.enabled
# Origin: Pixelfed
# Options: true | false
# MEDIA_HLS_ENABLED=false

# HLS Debug Logging
# Enable verbose debug logging for HLS video processing.
# Key: media.php -> hls.debug
# Origin: Pixelfed
# Options: true | false
# MEDIA_HLS_DEBUG=false

# Enable Video P2P support
# Enable optional video p2p support. Requires FFMPEG + HLS Disabled by default.
# Key: media.php -> hls.p2p
# Origin: Pixelfed
# Options: true | false
# MEDIA_HLS_P2P=false

# HLS P2P Debug Logging
# Enable verbose debug logging for the video P2P (WebTorrent) layer.
# Key: media.php -> hls.p2p_debug
# Origin: Pixelfed
# Options: true | false
# MEDIA_HLS_P2P_DEBUG=false

# HLS Bitrate
# Target bitrate (kbps) used when transcoding video to HLS.
# Key: media.php -> hls.bitrate
# Origin: Pixelfed
# MEDIA_HLS_BITRATE=1000

# HLS P2P Tracker
# WebTorrent tracker URL used for video P2P support.
# Key: media.php -> hls.tracker
# Origin: Pixelfed
# MEDIA_HLS_P2P_TRACKER=wss://tracker.webtorrent.dev

# HLS P2P ICE Server
# STUN/TURN ICE server used for WebRTC P2P connections.
# Key: media.php -> hls.ice
# Origin: Pixelfed
# MEDIA_HLS_P2P_ICE_SERVER=stun:stun.l.google.com:19302

# ----------------------------------------------------------------------------
# Image Processing  [config/image.php]  — Package (intervention/image-laravel)
# ----------------------------------------------------------------------------

# Image Driver
# Intervention Image supports “GD Library” and “Imagick” to process images
# internally. Depending on your PHP setup, you can choose one of them. Included
# options: - gd      = \Intervention\Image\Drivers\Gd\Driver::class - imagick =
# \Intervention\Image\Drivers\Imagick\Driver::class - vips    =
# \Intervention\Image\Drivers\vips\Driver::class
# Key: image.php -> driver
# Origin: Package (intervention/image-laravel)
# IMAGE_DRIVER=gd

# Configuration Options
# These options control the behavior of Intervention Image. - "autoOrientation"
# controls whether an imported image should be automatically rotated according
# to any existing Exif data. - "decodeAnimation" decides whether a possibly
# animated image is decoded as such or whether the animation is discarded. -
# "backgroundColor" Defines the default background color. - "strip" controls if
# meta data like exif tags should be removed when encoding images.
# Key: image.php -> options.backgroundColor
# Origin: Package (intervention/image-laravel)
# IMAGE_BACKGROUNDCOLOR=ffffff
# Key: image.php -> options.strip
# Origin: Package (intervention/image-laravel)
# Options: true | false
# IMAGE_STRIP=true

# ----------------------------------------------------------------------------
# Video Processing (FFmpeg)  [config/laravel-ffmpeg.php]  — Package (pbmedia/laravel-ffmpeg)
# ----------------------------------------------------------------------------

# FFmpeg Binary Path
# Path to the ffmpeg binary, or just 'ffmpeg' to use $PATH.
# Key: laravel-ffmpeg.php -> ffmpeg.binaries
# Origin: Package (pbmedia/laravel-ffmpeg)
# FFMPEG_BINARIES=ffmpeg

# FFmpeg Threads
# Number of threads ffmpeg should use. Set to false to use the ffmpeg default.
# Key: laravel-ffmpeg.php -> ffmpeg.threads
# Origin: Package (pbmedia/laravel-ffmpeg)
# Options: true | false
# FFMPEG_THREADS=false

# FFprobe Binary Path
# Path to the ffprobe binary, or just 'ffprobe' to use $PATH.
# Key: laravel-ffmpeg.php -> ffprobe.binaries
# Origin: Package (pbmedia/laravel-ffmpeg)
# FFPROBE_BINARIES=ffprobe

# FFmpeg Log Channel
# Laravel log channel to send ffmpeg output to. Set to false to disable ffmpeg
# logging entirely.
# Key: laravel-ffmpeg.php -> log_channel
# Origin: Package (pbmedia/laravel-ffmpeg)
# Options: true | false
# FFMPEG_LOG_CHANNEL=false

# FFmpeg Temp Directory
# Directory used for temporary files during video processing. Defaults to the
# system temp directory.
# Key: laravel-ffmpeg.php -> temporary_files_root, temporary_files_encrypted_hls
# Origin: Package (pbmedia/laravel-ffmpeg)
# Default is computed at runtime; see config/laravel-ffmpeg.php for details.
# FFMPEG_TEMPORARY_FILES_ROOT=

# FFmpeg Encrypted HLS Temp Directory
# Directory used for temporary encrypted HLS segment files. Defaults to
# FFMPEG_TEMPORARY_FILES_ROOT.
# Key: laravel-ffmpeg.php -> temporary_files_encrypted_hls
# Origin: Package (pbmedia/laravel-ffmpeg)
# Default is computed at runtime; see config/laravel-ffmpeg.php for details.
# FFMPEG_TEMPORARY_ENCRYPTED_HLS=

# Minimum HLS Version
# Minimum ffmpeg version required for HLS video transcoding support.
# Key: laravel-ffmpeg.php -> min_hls_version
# Origin: Package (pbmedia/laravel-ffmpeg)
# FFMPEG_MIN_HLS_VERSION=4.3.0

# ----------------------------------------------------------------------------
# Live Streaming  [config/livestreaming.php]  — Pixelfed
# ----------------------------------------------------------------------------

# Live Streaming
# Enable live streaming support.
# Used by 2 config files (all Pixelfed):
#   - exp.php -> hls
#   - livestreaming.php -> enabled
# Options: true | false
# HLS_LIVE=false

# Live Streaming RTMP Host
# Hostname the RTMP ingest server binds/advertises. Defaults to APP_DOMAIN.
# Key: livestreaming.php -> server.host
# Origin: Pixelfed
# Default is computed at runtime; see config/livestreaming.php for details.
# HLS_LIVE_HOST=

# Live Streaming RTMP Port
# Port the RTMP ingest server listens on.
# Key: livestreaming.php -> server.port
# Origin: Pixelfed
# HLS_LIVE_PORT=1935

# Live Streaming RTMP Path
# RTMP application path/stream key prefix.
# Key: livestreaming.php -> server.path
# Origin: Pixelfed
# HLS_LIVE_PATH=live

# Delete Stream Token After Broadcast
# Delete the broadcaster's stream token once a live broadcast finishes.
# Key: livestreaming.php -> broadcast.delete_token_after_finished
# Origin: Pixelfed
# Options: true | false
# HLS_LIVE_BROADCAST_DELETE_TOKEN_AFTER=true

# Max Broadcast Duration
# Maximum duration, in minutes, a single live broadcast may run.
# Key: livestreaming.php -> broadcast.max_duration
# Origin: Pixelfed
# HLS_LIVE_BROADCAST_MAX_DURATION=60

# Max Concurrent Broadcasts
# Maximum number of simultaneous live broadcasts allowed instance-wide.
# Key: livestreaming.php -> broadcast.max_active
# Origin: Pixelfed
# HLS_LIVE_BROADCAST_MAX_ACTIVE=10

# Broadcast Eligibility Limits
# Enable eligibility requirements (follower count, account age, etc) before a
# user can go live.
# Key: livestreaming.php -> broadcast.limits.enabled
# Origin: Pixelfed
# Options: true | false
# HLS_LIVE_BROADCAST_LIMITS=true

# Min Followers to Broadcast
# Minimum follower count required before a user can start a live broadcast.
# Key: livestreaming.php -> broadcast.limits.min_follower_count
# Origin: Pixelfed
# HLS_LIVE_BROADCAST_LIMITS_MIN_FOLLOWERS=100

# Min Account Age to Broadcast
# Minimum account age, in days, required before a user can start a live
# broadcast.
# Key: livestreaming.php -> broadcast.limits.min_account_age
# Origin: Pixelfed
# HLS_LIVE_BROADCAST_LIMITS_MIN_ACCOUNT_AGE=14

# Broadcast Admins Only
# Restrict live broadcasting to admin accounts only.
# Key: livestreaming.php -> broadcast.limits.admins_only
# Origin: Pixelfed
# Options: true | false
# HLS_LIVE_BROADCAST_LIMITS_ADMINS_ONLY=true

# Broadcast Source: App
# Allow starting live broadcasts from the mobile app.
# Key: livestreaming.php -> broadcast.sources.app
# Origin: Pixelfed
# Options: true | false
# HLS_LIVE_BROADCAST_SOURCE_APP=false

# Broadcast Source: Web
# Allow starting live broadcasts from the web browser source (e.g. webcam).
# Key: livestreaming.php -> broadcast.sources.web
# Origin: Pixelfed
# Options: true | false
# HLS_LIVE_BROADCAST_SOURCE_WEB=false

# Live Comments Buffer
# Maximum number of recent live comments retained/replayed to new viewers.
# Key: livestreaming.php -> comments.max_falloff
# Origin: Pixelfed
# HLS_LIVE_COMMENTS_MAX_FALLOFF=50

