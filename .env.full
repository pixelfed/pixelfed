# ----------------------------------------------------------------------------
# CAPTCHA (hCaptcha)  [config/captcha.php]  — Package (buzz/laravel-h-captcha)
# ----------------------------------------------------------------------------

# hCaptcha Enabled
# Enable hCaptcha support instance-wide. Individual forms are controlled by
# CAPTCHA_ENABLED_ON_* below.
# Used by 2 config files:
#   - captcha.php -> enabled [Package (buzz/laravel-h-captcha)]
#   - instance.php -> curated_registration.captcha_enabled [Pixelfed]
# Options: true | false
# CAPTCHA_ENABLED=false

# hCaptcha Secret Key
# Your hCaptcha secret key from https://www.hcaptcha.com/.
# Key: captcha.php -> secret
# Origin: Package (buzz/laravel-h-captcha)
# CAPTCHA_SECRET=default_secret

# hCaptcha Site Key
# Your hCaptcha site key from https://www.hcaptcha.com/.
# Key: captcha.php -> sitekey
# Origin: Package (buzz/laravel-h-captcha)
# CAPTCHA_SITEKEY=default_sitekey

# hCaptcha on Login
# Require hCaptcha verification on the login form.
# Key: captcha.php -> active.login
# Origin: Package (buzz/laravel-h-captcha)
# Options: true | false
# CAPTCHA_ENABLED_ON_LOGIN=false

# hCaptcha on Registration
# Require hCaptcha verification on the registration form.
# Key: captcha.php -> active.register
# Origin: Package (buzz/laravel-h-captcha)
# Options: true | false
# CAPTCHA_ENABLED_ON_REGISTER=false

# hCaptcha Login Trigger
# Dynamically require hCaptcha on login only after repeated failed attempts.
# Key: captcha.php -> triggers.login.enabled
# Origin: Package (buzz/laravel-h-captcha)
# Options: true | false
# CAPTCHA_TRIGGERS_LOGIN_ENABLED=false

# hCaptcha Login Trigger Attempts
# Number of failed login attempts before hCaptcha is required.
# Key: captcha.php -> triggers.login.attempts
# Origin: Package (buzz/laravel-h-captcha)
# CAPTCHA_TRIGGERS_LOGIN_ATTEMPTS=2

# ----------------------------------------------------------------------------
# Honeypot (Spam Protection)  [config/honeypot.php]  — Package (spatie/laravel-honeypot)
# ----------------------------------------------------------------------------

# This switch determines if the honeypot protection should be activated.
# Key: honeypot.php -> enabled
# Origin: Package (spatie/laravel-honeypot)
# Options: true | false
# HONEYPOT_ENABLED=true

# Here you can specify name of the honeypot field. Any requests that submit a non-empty
# value for this name will be discarded. Make sure this name does not collide
# with a form field that is actually used.
# Key: honeypot.php -> name_field_name
# Origin: Package (spatie/laravel-honeypot)
# HONEYPOT_NAME=my_name

# When this is activated there will be a random string added
# to the name_field_name. This improves the protection against bots.
# Key: honeypot.php -> randomize_name_field_name
# Origin: Package (spatie/laravel-honeypot)
# Options: true | false
# HONEYPOT_RANDOMIZE=true

# When this is activated, requests will be checked if
# form is submitted faster than this amount of seconds
# Key: honeypot.php -> valid_from_timestamp
# Origin: Package (spatie/laravel-honeypot)
# Options: true | false
# HONEYPOT_VALID_FROM_TIMESTAMP=true

# This field contains the name of a form field that will be used to verify
# if the form wasn't submitted too quickly. Make sure this name does not collide
# with a form field that is actually used.
# Key: honeypot.php -> valid_from_field_name
# Origin: Package (spatie/laravel-honeypot)
# HONEYPOT_VALID_FROM=valid_from

# If the form is submitted faster than this amount of seconds
# the form submission will be considered invalid.
# Key: honeypot.php -> amount_of_seconds
