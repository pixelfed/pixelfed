# Options: true | false
# LOG_DEPRECATIONS_TRACE=false

# Log Channels
# Here you may configure the log channels for your application. Laravel utilizes
# the Monolog PHP logging library, which includes a variety of powerful log
# handlers and formatters that you're free to use. Available drivers: "single",
# "daily", "slack", "syslog", "errorlog", "monolog", "custom", "stack"
# Key: logging.php -> channels.stack.channels
