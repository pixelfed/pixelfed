# Origin: Laravel core
# LOG_DAILY_DAYS=14
# Key: logging.php -> channels.slack.url
# Origin: Laravel core
# LOG_SLACK_WEBHOOK_URL=
# Key: logging.php -> channels.slack.username
# Origin: Laravel core
# Default is computed at runtime; see config/logging.php for details.
# LOG_SLACK_USERNAME=
# Key: logging.php -> channels.slack.emoji
# Origin: Laravel core
# LOG_SLACK_EMOJI=:boom:
# Key: logging.php -> channels.papertrail.handler
# Origin: Laravel core
# Default is computed at runtime; see config/logging.php for details.
# LOG_PAPERTRAIL_HANDLER=
# Key: logging.php -> channels.papertrail.handler_with.host, channels.papertrail.handler_with.connectionString
# Origin: Laravel core
# PAPERTRAIL_URL=
# Key: logging.php -> channels.papertrail.handler_with.port, channels.papertrail.handler_with.connectionString
# Origin: Laravel core
# PAPERTRAIL_PORT=
# Key: logging.php -> channels.stderr.formatter
