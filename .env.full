# Origin: Laravel core
# DB_CACHE_LOCK_TABLE=
# Key: cache.php -> stores.storage.disk
# Origin: Laravel core
# CACHE_STORAGE_DISK=
# Key: cache.php -> stores.storage.path
# Origin: Laravel core
# CACHE_STORAGE_PATH=framework/cache/data
# Key: cache.php -> stores.memcached.persistent_id
# Origin: Laravel core
# MEMCACHED_PERSISTENT_ID=
# Key: cache.php -> stores.memcached.sasl
# Origin: Laravel core
# MEMCACHED_USERNAME=
