# ----------------------------------------------------------------------------
# Pulse (Monitoring)  [config/pulse.php]  — Package (laravel/pulse)
# ----------------------------------------------------------------------------

# Pulse Domain
# This is the subdomain which the Pulse dashboard will be accessible from. When
# set to null, the dashboard will reside under the same domain as the
# application. Remember to configure your DNS entries correctly.
# Key: pulse.php -> domain
# Origin: Package (laravel/pulse)
# PULSE_DOMAIN=

# Pulse Path
# This is the path which the Pulse dashboard will be accessible from. Feel free
# to change this path to anything you'd like. Note that this won't affect the
# path of the internal API that is never exposed to users.
# Key: pulse.php -> path, ignore
# Origin: Package (laravel/pulse)
# PULSE_PATH=pulse

# Pulse Master Switch
# This configuration option may be used to completely disable all Pulse data
# recorders regardless of their individual configurations. This provides a
# single option to quickly disable all Pulse recording.
# Key: pulse.php -> enabled
# Origin: Package (laravel/pulse)
# Options: true | false
# PULSE_ENABLED=false

# Pulse Storage Driver
# This configuration option determines which storage driver will be used while
# storing entries from Pulse's recorders. In addition, you also may provide any
# options to configure the selected storage driver.
# Key: pulse.php -> storage.driver
# Origin: Package (laravel/pulse)
# Options: database
# PULSE_STORAGE_DRIVER=database
# Key: pulse.php -> storage.trim.keep
# Origin: Package (laravel/pulse)
# PULSE_STORAGE_KEEP="7 days"
# Key: pulse.php -> storage.database.connection
# Origin: Package (laravel/pulse)
# PULSE_DB_CONNECTION=

# Pulse Ingest Driver
# This configuration options determines the ingest driver that will be used to
# capture entries from Pulse's recorders. Ingest drivers are great to free up
# your request workers quickly by offloading the data storage.
# Key: pulse.php -> ingest.driver
# Origin: Package (laravel/pulse)
# Options: storage | redis
# PULSE_INGEST_DRIVER=storage
# Key: pulse.php -> ingest.buffer
# Origin: Package (laravel/pulse)
# Default is computed at runtime; see config/pulse.php for details.
# PULSE_INGEST_BUFFER=
# Key: pulse.php -> ingest.trim.keep
# Origin: Package (laravel/pulse)
# PULSE_INGEST_KEEP="7 days"
# Key: pulse.php -> ingest.redis.connection
# Origin: Package (laravel/pulse)
# PULSE_REDIS_CONNECTION=

# Pulse Cache Driver
# This configuration option determines the cache driver that will be used for
# various tasks, including caching dashboard results, establishing locks for
# events that should only occur on one server and signals.
# Key: pulse.php -> cache
# Origin: Package (laravel/pulse)
# Options: apc | array | database | file | storage | memcached | redis | dynamodb | octane | failover
# PULSE_CACHE_DRIVER=

# Pulse Recorders
# The following array lists the "recorders" that will be registered with Pulse,
# along with their configuration. Recorders gather application event data from
# requests and tasks to pass to your ingest driver.
# Key: pulse.php -> recorders.enabled
# Origin: Package (laravel/pulse)
# Options: true | false
# PULSE_CACHE_INTERACTIONS_ENABLED=true
# Key: pulse.php -> recorders.sample_rate
# Origin: Package (laravel/pulse)
# PULSE_CACHE_INTERACTIONS_SAMPLE_RATE=1

# Pulse: Exceptions Recorder
# Record application exceptions for the Pulse dashboard.
# Key: pulse.php -> enabled
# Origin: Package (laravel/pulse)
# Options: true | false
# PULSE_EXCEPTIONS_ENABLED=true

# Pulse: Exceptions Sample Rate
# Fraction (0-1) of exceptions sampled by the exceptions recorder.
# Key: pulse.php -> sample_rate
# Origin: Package (laravel/pulse)
# PULSE_EXCEPTIONS_SAMPLE_RATE=1

# Pulse: Exceptions Location
# Capture the file/line location an exception originated from.
# Key: pulse.php -> location
# Origin: Package (laravel/pulse)
# Options: true | false
# PULSE_EXCEPTIONS_LOCATION=true

# Pulse: Queues Recorder
# Record queue throughput (processed/failed jobs) for the Pulse dashboard.
# Key: pulse.php -> enabled
# Origin: Package (laravel/pulse)
# Options: true | false
# PULSE_QUEUES_ENABLED=true

# Pulse: Queues Sample Rate
# Fraction (0-1) of queue events sampled by the queues recorder.
# Key: pulse.php -> sample_rate
# Origin: Package (laravel/pulse)
# PULSE_QUEUES_SAMPLE_RATE=1

# Pulse: Server Name
# Name this server reports as in the Pulse Servers card. Defaults to the machine
# hostname.
# Key: pulse.php -> server_name
# Origin: Package (laravel/pulse)
# Default is computed at runtime; see config/pulse.php for details.
# PULSE_SERVER_NAME=

# Pulse: Server Directories
# Colon separated list of disk paths Pulse reports free space for.
# Key: pulse.php -> directories
# Origin: Package (laravel/pulse)
# PULSE_SERVER_DIRECTORIES=/

# Pulse: Slow Jobs Recorder
# Record queued jobs that exceed the slow job threshold.
# Key: pulse.php -> enabled
# Origin: Package (laravel/pulse)
# Options: true | false
# PULSE_SLOW_JOBS_ENABLED=true

# Pulse: Slow Jobs Sample Rate
# Fraction (0-1) of jobs sampled by the slow jobs recorder.
# Key: pulse.php -> sample_rate
# Origin: Package (laravel/pulse)
# PULSE_SLOW_JOBS_SAMPLE_RATE=1

# Pulse: Slow Jobs Threshold
# Job duration, in milliseconds, above which a job is considered slow.
# Key: pulse.php -> threshold
# Origin: Package (laravel/pulse)
# PULSE_SLOW_JOBS_THRESHOLD=1000

# Pulse: Slow Outgoing Requests Recorder
# Record outgoing HTTP client requests that exceed the slow threshold.
# Key: pulse.php -> enabled
# Origin: Package (laravel/pulse)
# Options: true | false
# PULSE_SLOW_OUTGOING_REQUESTS_ENABLED=true

# Pulse: Slow Outgoing Requests Sample Rate
# Fraction (0-1) of outgoing requests sampled.
# Key: pulse.php -> sample_rate
# Origin: Package (laravel/pulse)
# PULSE_SLOW_OUTGOING_REQUESTS_SAMPLE_RATE=1

# Pulse: Slow Outgoing Requests Threshold
# Duration, in milliseconds, above which an outgoing HTTP request is considered
# slow.
# Key: pulse.php -> threshold
# Origin: Package (laravel/pulse)
# PULSE_SLOW_OUTGOING_REQUESTS_THRESHOLD=1000

# Pulse: Slow Queries Recorder
# Record database queries that exceed the slow query threshold.
# Key: pulse.php -> enabled
# Origin: Package (laravel/pulse)
# Options: true | false
# PULSE_SLOW_QUERIES_ENABLED=true

# Pulse: Slow Queries Sample Rate
# Fraction (0-1) of queries sampled by the slow queries recorder.
# Key: pulse.php -> sample_rate
# Origin: Package (laravel/pulse)
# PULSE_SLOW_QUERIES_SAMPLE_RATE=1

# Pulse: Slow Queries Threshold
# Query duration, in milliseconds, above which a query is considered slow.
# Key: pulse.php -> threshold
# Origin: Package (laravel/pulse)
# PULSE_SLOW_QUERIES_THRESHOLD=1000

# Pulse: Slow Queries Location
# Capture the file/line location a slow query originated from.
# Key: pulse.php -> location
# Origin: Package (laravel/pulse)
# Options: true | false
# PULSE_SLOW_QUERIES_LOCATION=true

# Pulse: Slow Queries Max Length
# Maximum SQL query length recorded before truncation.
# Key: pulse.php -> max_query_length
# Origin: Package (laravel/pulse)
# PULSE_SLOW_QUERIES_MAX_QUERY_LENGTH=

# Pulse: Slow Requests Recorder
# Record incoming HTTP requests that exceed the slow request threshold.
# Key: pulse.php -> enabled
# Origin: Package (laravel/pulse)
# Options: true | false
# PULSE_SLOW_REQUESTS_ENABLED=true

# Pulse: Slow Requests Sample Rate
# Fraction (0-1) of requests sampled by the slow requests recorder.
# Key: pulse.php -> sample_rate
# Origin: Package (laravel/pulse)
# PULSE_SLOW_REQUESTS_SAMPLE_RATE=1

# Pulse: Slow Requests Threshold
# Request duration, in milliseconds, above which a request is considered slow.
# Key: pulse.php -> threshold
# Origin: Package (laravel/pulse)
# PULSE_SLOW_REQUESTS_THRESHOLD=1000

# Pulse: Top Users by Jobs Recorder
# Record which users dispatch the most queued jobs.
# Key: pulse.php -> enabled
# Origin: Package (laravel/pulse)
# Options: true | false
# PULSE_USER_JOBS_ENABLED=true

# Pulse: Top Users by Jobs Sample Rate
# Fraction (0-1) of job dispatches sampled for the top-users-by-jobs card.
# Key: pulse.php -> sample_rate
# Origin: Package (laravel/pulse)
# PULSE_USER_JOBS_SAMPLE_RATE=1

# Pulse: Top Users by Requests Recorder
# Record which users make the most HTTP requests.
# Key: pulse.php -> enabled
# Origin: Package (laravel/pulse)
# Options: true | false
# PULSE_USER_REQUESTS_ENABLED=true

# Pulse: Top Users by Requests Sample Rate
# Fraction (0-1) of requests sampled for the top-users-by-requests card.
# Key: pulse.php -> sample_rate
# Origin: Package (laravel/pulse)
# PULSE_USER_REQUESTS_SAMPLE_RATE=1

# ----------------------------------------------------------------------------
# Third-Party Services  [config/services.php]  — Laravel core
# ----------------------------------------------------------------------------

# Third Party Services
# This file is for storing the credentials for third party services such as
# Stripe, Mailgun, SparkPost and others. This file provides a sane default
# location for this type of information, allowing packages to have a
# conventional place to find your various credentials.
# Key: services.php -> mailgun.domain
# Origin: Laravel core
# MAILGUN_DOMAIN=
# Key: services.php -> mailgun.secret
# Origin: Laravel core
# MAILGUN_SECRET=
# Key: services.php -> mailgun.endpoint
# Origin: Laravel core
# MAILGUN_ENDPOINT=api.mailgun.net

# AWS SES Key
# AWS access key id used for sending mail via Amazon SES.
# Key: services.php -> ses.key
# Origin: Laravel core
# SES_KEY=

# AWS SES Secret
# AWS secret access key used for sending mail via Amazon SES.
# Key: services.php -> ses.secret
# Origin: Laravel core
# SES_SECRET=

# AWS SES Region
# AWS region for the Amazon SES mail driver.
# Key: services.php -> ses.region
# Origin: Laravel core
# SES_REGION=us-east-1

# SparkPost API Key
# API key used for sending mail via SparkPost.
# Key: services.php -> sparkpost.secret
# Origin: Laravel core
# SPARKPOST_SECRET=

# Stripe Publishable Key
# Stripe publishable API key, if payment features are used.
# Key: services.php -> stripe.key
# Origin: Laravel core
# STRIPE_KEY=

# Stripe Secret Key
# Stripe secret API key, if payment features are used.
# Key: services.php -> stripe.secret
# Origin: Laravel core
# STRIPE_SECRET=

# Expo Access Token
# Access token for sending push notifications via Expo (mobile app).
# Key: services.php -> expo.access_token
# Origin: Laravel core
# EXPO_ACCESS_TOKEN=

# Resend API Key
# API key used for sending mail via Resend.
# Key: services.php -> resend.key
# Origin: Laravel core
# RESEND_KEY=

# ----------------------------------------------------------------------------
# Scheduled Tasks  [config/scheduledtasks.php]  — Pixelfed
# ----------------------------------------------------------------------------

# Account storage reconciler
# Optional weekly scheduled task that recalculates users.storage_used from
# actual media, correcting drift on accounts that never upload or delete. The
# upload/delete/read paths already self-heal stale counters, so this is a
# background hygiene job and is disabled by default.
# Key: scheduledtasks.php -> account_storage_reconcile
# Origin: Pixelfed
# Options: true | false
# ACCOUNT_STORAGE_RECONCILE=false

# ----------------------------------------------------------------------------
# API Rate Limits  [config/api.php]  — Pixelfed
# ----------------------------------------------------------------------------

# API Rate Limit: username-to-id
# Enable rate limiting on the v1.1 accounts username-to-id lookup endpoint.
# Key: api.php -> rate-limits.v1Dot1.accounts.usernameToId.enabled
# Origin: Pixelfed
# Options: true | false
# PF_API_RL_V1DOT1_ACCT_U2ID_ENABLED=true

# API Rate Limit: username-to-id (per token)
# Max requests per decay window, per access token, for the username-to-id
# endpoint.
# Key: api.php -> rate-limits.v1Dot1.accounts.usernameToId.limit
# Origin: Pixelfed
# PF_API_RL_V1DOT1_ACCT_U2ID_LIMIT=30

# API Rate Limit: username-to-id decay
# Rate limit decay window, in seconds, per access token.
# Key: api.php -> rate-limits.v1Dot1.accounts.usernameToId.decay
# Origin: Pixelfed
# PF_API_RL_V1DOT1_ACCT_U2ID_DECAY=120

# API Rate Limit: username-to-id by IP
# Also rate limit the username-to-id endpoint by IP address.
# Key: api.php -> rate-limits.v1Dot1.accounts.usernameToId.ip_enabled
# Origin: Pixelfed
# Options: true | false
# PF_API_RL_V1DOT1_ACCT_U2ID_BY_IP_ENABLED=false

# API Rate Limit: username-to-id by IP (limit)
# Max requests per decay window, per IP address.
# Key: api.php -> rate-limits.v1Dot1.accounts.usernameToId.ip_limit
# Origin: Pixelfed
# PF_API_RL_V1DOT1_ACCT_U2ID_BY_IP_LIMIT=30

# API Rate Limit: username-to-id by IP (decay)
# Rate limit decay window, in seconds, per IP address.
# Key: api.php -> rate-limits.v1Dot1.accounts.usernameToId.ip_decay
# Origin: Pixelfed
# PF_API_RL_V1DOT1_ACCT_U2ID_BY_IP_DECAY=120

