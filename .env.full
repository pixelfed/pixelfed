# Origin: Package (laravel/telescope)
# Options: true | false
# TELESCOPE_JOB_WATCHER=true

# Telescope: Log Watcher
# Record log entries in the Telescope dashboard.
# Key: telescope.php
# Origin: Package (laravel/telescope)
# Options: true | false
# TELESCOPE_LOG_WATCHER=true

# Telescope: Mail Watcher
# Record sent emails in the Telescope dashboard.
# Key: telescope.php
# Origin: Package (laravel/telescope)
# Options: true | false
# TELESCOPE_MAIL_WATCHER=true

# Telescope: Model Watcher
# Record Eloquent model events in the Telescope dashboard.
# Key: telescope.php -> enabled
# Origin: Package (laravel/telescope)
# Options: true | false
# TELESCOPE_MODEL_WATCHER=true

# Telescope: Notification Watcher
# Record sent notifications in the Telescope dashboard.
# Key: telescope.php
