# In-App Registration
# Allow account registration from within the mobile app.
# Key: auth.php -> in_app_registration
# Origin: Laravel core
# Options: true | false
# APP_REGISTER=true

# Password Confirmation Timeout
# Here you may define the amount of seconds before a password confirmation times
# out and the user is prompted to re-enter their password via the confirmation
# screen. By default, the timeout lasts for three hours.
# Key: auth.php -> password_timeout
# Origin: Laravel core
# AUTH_PASSWORD_TIMEOUT=1800

# ----------------------------------------------------------------------------
# Session  [config/session.php]  — Laravel core
# ----------------------------------------------------------------------------

# Default Session Driver
# This option determines the default session driver that is utilized for
# incoming requests. Laravel supports a variety of storage options to persist
# session data. Database storage is a great default choice. Supported: "file",
# "cookie", "database", "memcached", "redis", "dynamodb", "array"
# Key: session.php -> driver
# Origin: Laravel core
# Options: file | cookie | database | memcached | redis | dynamodb | array
# SESSION_DRIVER=database

# Session Lifetime
# Here you may specify the number of minutes that you wish the session to be
# allowed to remain idle before it expires. If you want them to expire
# immediately when the browser is closed then you may indicate that via the
# expire_on_close configuration option.
# Key: session.php -> lifetime
# Origin: Laravel core
# SESSION_LIFETIME=120

# Expire Session on Browser Close
# Expire the session when the browser is closed, ignoring the configured session
# lifetime.
# Key: session.php -> expire_on_close
# Origin: Laravel core
# Options: true | false
# SESSION_EXPIRE_ON_CLOSE=false

# Session Encryption
# This option allows you to easily specify that all of your session data should
# be encrypted before it's stored. All encryption is performed automatically by
# Laravel and you may use the session like normal.
# Key: session.php -> encrypt
# Origin: Laravel core
# Options: true | false
# SESSION_ENCRYPT=false

# Session Database Connection
# When using the "database" or "redis" session drivers, you may specify a
# connection that should be used to manage these sessions. This should
# correspond to a connection in your database configuration options.
# Key: session.php -> connection
# Origin: Laravel core
# SESSION_CONNECTION=

# Session Database Table
# When using the "database" session driver, you may specify the table to be used
# to store sessions. Of course, a sensible default is defined for you; however,
# you're welcome to change this to another table.
# Key: session.php -> table
# Origin: Laravel core
# SESSION_TABLE=sessions

# Session Cache Store
# When using one of the framework's cache driven session backends, you may
# define the cache store which should be used to store the session data between
# requests. This must match one of your defined cache stores. Affects:
# "dynamodb", "memcached", "redis"
# Key: session.php -> store
# Origin: Laravel core
# SESSION_STORE=

# Session Cookie Name
# Here you may change the name of the session cookie that is created by the
# framework. Typically, you should not need to change this value since doing so
# does not grant a meaningful security improvement.
# Key: session.php -> cookie
# Origin: Laravel core
# SESSION_COOKIE=pxfs

# Session Cookie Path
# The session cookie path determines the path for which the cookie will be
# regarded as available. Typically, this will be the root path of your
# application, but you're free to change this when necessary.
# Key: session.php -> path
# Origin: Laravel core
# SESSION_PATH=/

# Session Cookie Domain
# This value determines the domain and subdomains the session cookie is
# available to. By default, the cookie will be available to the root domain
# without subdomains. Typically, this shouldn't be changed.
# Key: session.php -> domain
# Origin: Laravel core
# Default is computed at runtime; see config/session.php for details.
# SESSION_DOMAIN=

# HTTPS Only Cookies
# By setting this option to true, session cookies will only be sent back to the
# server if the browser has a HTTPS connection. This will keep the cookie from
# being sent to you when it can't be done securely.
# Key: session.php -> secure
# Origin: Laravel core
# Options: true | false
# SESSION_SECURE_COOKIE=true

# HTTP Access Only
# Setting this value to true will prevent JavaScript from accessing the value of
# the cookie and the cookie will only be accessible through the HTTP protocol.
# It's unlikely you should disable this option.
# Key: session.php -> http_only
# Origin: Laravel core
# Options: true | false
# SESSION_HTTP_ONLY=true

# Same-Site Cookies
# This option determines how your cookies behave when cross-site requests take
# place, and can be used to mitigate CSRF attacks. By default, we will set this
# value to "lax" to permit secure cross-site requests. See:
# https://developer.mozilla.org/en-US/docs/Web/HTTP/Headers/Set-
# Cookie#samesitesamesite-value Supported: "lax", "strict", "none", null
# Key: session.php -> same_site
# Origin: Laravel core
# Options: lax | strict | none | null
# Default is computed at runtime; see config/session.php for details.
# SESSION_SAME_SITE_COOKIES=

# Same-Site Cookies
# This option determines how your cookies behave when cross-site requests take
# place, and can be used to mitigate CSRF attacks. By default, we will set this
# value to "lax" to permit secure cross-site requests. See:
# https://developer.mozilla.org/en-US/docs/Web/HTTP/Headers/Set-
# Cookie#samesitesamesite-value Supported: "lax", "strict", "none", null
# Key: session.php -> same_site
# Origin: Laravel core
# Options: lax | strict | none | null
# NOTE: Deprecated alias, prefer SESSION_SAME_SITE_COOKIES. Only used as a fallback
# when SESSION_SAME_SITE_COOKIES is not set.
# SESSION_SAME_SITE=lax

# Partitioned Cookies
# Setting this value to true will tie the cookie to the top-level site for a
# cross-site context. Partitioned cookies are accepted by the browser when
# flagged "secure" and the Same-Site attribute is set to "none".
# Key: session.php -> partitioned
# Origin: Laravel core
# Options: true | false
# SESSION_PARTITIONED_COOKIE=false

# ----------------------------------------------------------------------------
# Database  [config/database.php]  — Laravel core
# ----------------------------------------------------------------------------

# Redis Databases
# Redis is an open source, fast, and advanced key-value store that also provides
# a richer body of commands than a typical key-value system such as Memcached.
# You may define your connection settings here.
# Used by 2 config files (all Laravel core):
#   - cache.php -> stores.redis.client
#   - database.php -> redis.client
# Options: phpredis | predis
# REDIS_CLIENT=phpredis
# Used by 2 config files (all Laravel core):
#   - cache.php -> stores.redis.default.scheme, stores.redis.session.scheme, stores.redis.pulse.scheme
#   - database.php -> redis.default.scheme, redis.session.scheme, redis.pulse.scheme
# Options: tcp | tls | unix
# REDIS_SCHEME=tcp
# Used by 2 config files (all Laravel core):
#   - cache.php -> stores.redis.default.path, stores.redis.session.path, stores.redis.pulse.path
#   - database.php -> redis.default.path, redis.session.path, redis.pulse.path
# REDIS_PATH=
# Used by 2 config files (all Laravel core):
#   - cache.php -> stores.redis.default.host, stores.redis.session.host, stores.redis.pulse.host
#   - database.php -> redis.default.host, redis.session.host, redis.pulse.host, redis.cache.host
# REDIS_HOST=127.0.0.1
# Used by 2 config files (all Laravel core):
#   - cache.php -> stores.redis.default.password, stores.redis.session.password, stores.redis.pulse.password
#   - database.php -> redis.default.password, redis.session.password, redis.pulse.password, redis.cache.password
# REDIS_PASSWORD=
# Used by 2 config files (all Laravel core):
#   - cache.php -> stores.redis.default.port, stores.redis.session.port, stores.redis.pulse.port
#   - database.php -> redis.default.port, redis.session.port, redis.pulse.port, redis.cache.port
# REDIS_PORT=6379
# Used by 2 config files (all Laravel core):
#   - cache.php -> stores.redis.session.database
#   - database.php -> redis.session.database
# REDIS_DATABASE_SESSION=1
# Used by 2 config files (all Laravel core):
#   - cache.php -> stores.redis.pulse.database
#   - database.php -> redis.pulse.database
# REDIS_DATABASE_PULSE=2

# Default Database Connection Name
# Here you may specify which of the database connections below you wish to use
# as your default connection for database operations. This is the connection
# which will be utilized unless another connection is explicitly specified when
# you execute a query / statement.
# Used by 4 config files:
#   - database.php -> default [Laravel core]
#   - queue.php -> batching.database, failed.database [Laravel core]
#   - telescope.php -> storage.database.connection [Package (laravel/telescope)]
#   - webpush.php -> database_connection [Package (laravel-notification-channels/webpush)]
# Options: sqlite | mysql | mariadb | pgsql | sqlsrv
# DB_CONNECTION=mysql

# Database Connections
# Below are all of the database connections defined for your application. An
# example configuration is provided for each database system which is supported
# by Laravel. You're free to add / remove connections.
# Key: database.php -> connections.sqlite.url, connections.mysql.url, connections.mariadb.url, connections.pgsql.url, connections.sqlsrv.url
# Origin: Laravel core
# DB_URL=
# Key: database.php -> connections.sqlite.database, connections.mysql.database, connections.mariadb.database, connections.pgsql.database, connections.sqlsrv.database
# Origin: Laravel core
# Default is computed at runtime; see config/database.php for details.
# DB_DATABASE=
# Key: database.php -> connections.sqlite.foreign_key_constraints
# Origin: Laravel core
# Options: true | false
# DB_FOREIGN_KEYS=true
# Key: database.php -> connections.mysql.host, connections.mariadb.host, connections.pgsql.host, connections.sqlsrv.host
# Origin: Laravel core
# DB_HOST=127.0.0.1
# Key: database.php -> connections.mysql.port, connections.mariadb.port, connections.pgsql.port, connections.sqlsrv.port
# Origin: Laravel core
# DB_PORT=3306
# Key: database.php -> connections.mysql.username, connections.mariadb.username, connections.pgsql.username, connections.sqlsrv.username
# Origin: Laravel core
# DB_USERNAME=root
# Key: database.php -> connections.mysql.password, connections.mariadb.password, connections.pgsql.password, connections.sqlsrv.password
# Origin: Laravel core
# DB_PASSWORD=""
# Key: database.php -> connections.mysql.unix_socket, connections.mariadb.unix_socket
# Origin: Laravel core
# DB_SOCKET=""
# Key: database.php -> connections.mysql.charset, connections.mariadb.charset, connections.pgsql.charset, connections.sqlsrv.charset
# Origin: Laravel core
# DB_CHARSET=utf8mb4
# Key: database.php -> connections.mysql.collation, connections.mariadb.collation
# Origin: Laravel core
# DB_COLLATION=utf8mb4_unicode_ci
# Key: database.php -> connections.mysql.strict
# Origin: Laravel core
# Options: true | false
# DB_STRICT=false
# Key: database.php -> connections.mysql, connections.mariadb
# Origin: Laravel core
# MYSQL_ATTR_SSL_CA=
# Key: database.php -> connections.pgsql.sslmode
# Origin: Laravel core
# DB_SSLMODE=prefer

# Redis Databases
# Redis is an open source, fast, and advanced key-value store that also provides
# a richer body of commands than a typical key-value system such as Memcached.
# You may define your connection settings here.
# Key: database.php -> redis.options.cluster
# Origin: Laravel core
# REDIS_CLUSTER=redis
# Key: database.php -> redis.options.prefix
# Origin: Laravel core
# Default is computed at runtime; see config/database.php for details.
# REDIS_PREFIX=
# Key: database.php -> redis.options.persistent
# Origin: Laravel core
# Options: true | false
# REDIS_PERSISTENT=false
# Key: database.php -> redis.default.url, redis.cache.url
# Origin: Laravel core
# REDIS_URL=
# Key: database.php -> redis.default.username, redis.session.username, redis.pulse.username, redis.cache.username
# Origin: Laravel core
# REDIS_USERNAME=
# Key: database.php -> redis.default.database
# Origin: Laravel core
# REDIS_DB=0
# Key: database.php -> redis.default.max_retries, redis.cache.max_retries
# Origin: Laravel core
# REDIS_MAX_RETRIES=3
# Key: database.php -> redis.default.backoff_algorithm, redis.cache.backoff_algorithm
# Origin: Laravel core
# REDIS_BACKOFF_ALGORITHM=decorrelated_jitter
# Key: database.php -> redis.default.backoff_base, redis.cache.backoff_base
# Origin: Laravel core
# REDIS_BACKOFF_BASE=100
# Key: database.php -> redis.default.backoff_cap, redis.cache.backoff_cap
# Origin: Laravel core
# REDIS_BACKOFF_CAP=1000
# Key: database.php -> redis.cache.database
# Origin: Laravel core
# REDIS_CACHE_DB=1

# SQL Server: Encrypt Connection
# Encrypt the connection to a SQL Server database. Only used with
# DB_CONNECTION=sqlsrv.
# Key: database.php -> connections.sqlsrv.encrypt
# Origin: Laravel core
# DB_ENCRYPT=yes

# SQL Server: Trust Server Certificate
# Trust the SQL Server's TLS certificate without validating it. Only used with
