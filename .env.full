# ----------------------------------------------------------------------------
# Remote Login (Sign in with Mastodon / OIDC)  [config/remote-auth.php]  — Pixelfed
# ----------------------------------------------------------------------------

# Sign in with Mastodon
# Allow users to sign in/import their account using a Mastodon account.
# Key: remote-auth.php -> mastodon.enabled
# Origin: Pixelfed
# Options: true | false
# PF_LOGIN_WITH_MASTODON_ENABLED=false

# Sign in with Mastodon: Ignore Closed Registration
# Allow Sign-in with Mastodon even when open registration is closed.
# Key: remote-auth.php -> mastodon.ignore_closed_state
# Origin: Pixelfed
# Options: true | false
# PF_LOGIN_WITH_MASTODON_ENABLED_SKIP_CLOSED=false

# Skip email verification
# To improve the onboarding experience, you can opt to skip the email
# verification process and automatically verify their email
# Key: remote-auth.php -> mastodon.contraints.skip_email_verification
# Origin: Pixelfed
# Options: true | false
# PF_LOGIN_WITH_MASTODON_SKIP_EMAIL=true

# Custom mastodon domains
# Define a comma separated list of custom domains to allow
# Key: remote-auth.php -> mastodon.domains.custom
# Origin: Pixelfed
# PF_LOGIN_WITH_MASTODON_DOMAINS=

# Use only default domains
# Allow Sign-in with Mastodon using only the default domains
# Key: remote-auth.php -> mastodon.domains.only_default
# Origin: Pixelfed
# Options: true | false
# PF_LOGIN_WITH_MASTODON_ONLY_DEFAULT=false

# Use only custom domains
# Allow Sign-in with Mastodon using only the custom domains you define, in comma
# separated format
# Key: remote-auth.php -> mastodon.domains.only_custom
# Origin: Pixelfed
# Options: true | false
# PF_LOGIN_WITH_MASTODON_ONLY_CUSTOM=false

# Max Uses
# Using a centralized service operated by pixelfed.org that tracks mastodon
# imports, you can set a limit of how many times a mastodon account can be
# imported across all known and reporting Pixelfed instances to prevent the same
# masto account from abusing this
# Key: remote-auth.php -> mastodon.max_uses.enabled
# Origin: Pixelfed
# Options: true | false
# PF_LOGIN_WITH_MASTODON_ENFORCE_MAX_USES=true

# Sign in with Mastodon: Max Uses Limit
# Maximum number of times a single Mastodon account may be imported, when max-
# uses enforcement is enabled.
# Key: remote-auth.php -> mastodon.max_uses.limit
# Origin: Pixelfed
# PF_LOGIN_WITH_MASTODON_MAX_USES_LIMIT=3

# Enable OIDC authentication
# Enable Sign-in with OpenID Connect (OIDC) authentication providers
# Key: remote-auth.php -> oidc.enabled
# Origin: Pixelfed
# Options: true | false
# PF_OIDC_ENABLED=false

# Client ID
# The client ID provided by your OIDC provider
# Key: remote-auth.php -> oidc.clientId
# Origin: Pixelfed
# Options: true | false
# PF_OIDC_CLIENT_ID=false

# Client Secret
# The client secret provided by your OIDC provider
# Key: remote-auth.php -> oidc.clientSecret
# Origin: Pixelfed
# Options: true | false
# PF_OIDC_CLIENT_SECRET=false

# OAuth Scopes
# The scopes to request from the OIDC provider, typically including 'openid'
# (required), 'profile', and 'email' for basic user information
# Key: remote-auth.php -> oidc.scopes
# Origin: Pixelfed
# PF_OIDC_SCOPES="openid profile email"

# Authorization URL
# The endpoint used to start the OIDC authentication flow
# Key: remote-auth.php -> oidc.authorizeURL
# Origin: Pixelfed
# PF_OIDC_AUTHORIZE_URL=""

# Token URL
# The endpoint used to exchange the authorization code for an access token
# Key: remote-auth.php -> oidc.tokenURL
# Origin: Pixelfed
# PF_OIDC_TOKEN_URL=""

# Profile URL
# The endpoint used to retrieve user information with a valid access token
# Key: remote-auth.php -> oidc.profileURL
# Origin: Pixelfed
# PF_OIDC_PROFILE_URL=""

# Logout URL
# The endpoint used to log the user out of the OIDC provider
# Key: remote-auth.php -> oidc.logoutURL
# Origin: Pixelfed
# PF_OIDC_LOGOUT_URL=""

# Username Field
# The field from the OIDC profile response to use as the username Default is
# 'preferred_username' but can be changed based on your provider
# Key: remote-auth.php -> oidc.field_username
# Origin: Pixelfed
# PF_OIDC_USERNAME_FIELD=preferred_username

# ID Field
# The field from the OIDC profile response to use as the unique identifier
# Default is 'sub' (subject) which is standard in OIDC implementations
# Key: remote-auth.php -> oidc.field_id
# Origin: Pixelfed
# PF_OIDC_FIELD_ID=sub

