# Default is computed at runtime; see config/cache.php for details.
# CACHE_STORE=

# Default Cache Store
# This option controls the default cache store that will be used by the
# framework. This connection is utilized if another isn't explicitly specified
# when running a cache operation inside the application.
# Used by 3 config files:
#   - cache.php -> default [Laravel core]
#   - ldap.php -> cache.driver [Package (directorytree/ldaprecord-laravel) — not installed by default]
#   - purify.php -> serializer.driver [Package (stevebauman/purify)]
# Options: apc | array | database | file | storage | memcached | redis | dynamodb | octane | failover
# NOTE: Deprecated alias, prefer CACHE_STORE. Only used as a fallback
# when CACHE_STORE is not set.
# CACHE_DRIVER=file

