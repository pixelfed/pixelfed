{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",

  extends: [
    "config:recommended",
    "helpers:pinGitHubActionDigests",
    "customManagers:dockerfileVersions",
    "customManagers:githubActionsVersions",
    ':enableVulnerabilityAlertsWithLabel(security)',
  ],

  // Only scan and open PRs against staging; dev is ignored.
  baseBranchPatterns: ["staging"],
  // Renovate normally reads config only from the default branch. "merge" also applies this file as found on staging.
  useBaseBranchConfig: "merge",

  labels: ["dependencies"],
  prConcurrentLimit: 15,

  minimumReleaseAge: "3 days",

  vulnerabilityAlerts: {
    labels: ["security"],
    schedule: ["at any time"],
    minimumReleaseAge: null,
  },

  lockFileMaintenance: {
    enabled: true,
    schedule: ["before 6am on sunday"],
  },

  // ---- Node.js disabled for now ----
  npm: { enabled: false },
  nvm: { enabled: false },
  nodenv: { enabled: false },

  packageRules: [
    {
      groupName: "laravel",
      matchManagers: ["composer"],
      matchPackageNames: ["laravel/**", "illuminate/**"],
      matchUpdateTypes: ["minor", "patch"],
    },

    {
      matchPackageNames: ["node", "**/node"],
      matchDatasources: ["docker", "node-version"],
      enabled: false,
    },

    {
      groupName: "docker base images",
      matchManagers: ["dockerfile", "docker-compose"],
      matchUpdateTypes: ["patch", "digest", "pin"],
    },

    {
      groupName: "github actions",
      matchManagers: ["github-actions"],
      matchUpdateTypes: ["minor", "patch", "digest", "pin"],
    },

    // Manual Approval
    {
      matchDatasources: ["docker"],
      matchPackageNames: ["mysql", "mariadb", "postgres", "redis", "valkey"],
      matchUpdateTypes: ["major", "minor"],
      dependencyDashboardApproval: true,
    },

    {
      matchManagers: ["composer"],
      matchUpdateTypes: ["major"],
      dependencyDashboardApproval: true,
    },

    {
      matchDatasources: ["docker"],
      matchPackageNames: ["composer"],
      matchUpdateTypes: ["major"],
      dependencyDashboardApproval: true,
    },

    {
      matchDatasources: ["docker"],
      matchPackageNames: ["php", "**/php"],
      matchUpdateTypes: ["major", "minor"],
      dependencyDashboardApproval: true,
    },
  ],
}
